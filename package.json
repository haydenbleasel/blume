{
  "name": "blume-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=!video",
    "bench": "cd packages/blume && bun run bench",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=!video && changeset publish",
    "bundle-docs": "node packages/blume/scripts/bundle-docs.mjs",
    "prepare": "husky && node packages/blume/scripts/bundle-docs.mjs",
    "bump-deps": "npx npm-check-updates -u --deep && bun i",
    "generate-guide-image": "cd apps/docs && bun run generate-guide-image",
    "translate": "cd apps/docs && bun translate --claude --concurrency 16 && cd ../.. && bun fix"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orama/orama": "^3.1.18",
    "astro": "^7.3.4",
    "html-escaper": "^3.0.3",
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "sharp": "^0.35.4",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "ufo": "^1.6.4",
    "ultracite": "^7.12.2",
    "zod": "^4.6.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "oxfmt@0.71.0": "patches/oxfmt@0.71.0.patch"
  }
}
