---
// The pricing page (/pricing). Blume has no plans to sell, but readers and the
// agents researching on their behalf look for this route, so it answers the
// question they're really asking: what docs on Blume cost to run. The hero
// states the one plan, the calculator prices a team's docs on Blume beside
// Mintlify (the hosted platform the compare pages set it against), then the
// costs feature by feature, including Mintlify's AI credits, what each host
// charges, where Mintlify suits better (from its compare entry), the GitHub
// Sponsors tiers for anyone who wants to pay anyway, questions (also emitted
// as FAQPage JSON-LD), and the install CTA. Every third-party price lives in
// _pricing/prices.ts beside its source.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Faq from "./_compare/Faq.astro";
import Fit from "./_compare/Fit.astro";
import { compareTool } from "./_compare/tools.ts";
import Footer from "./_home/Footer.astro";
import InstallCta from "./_home/InstallCta.astro";
import Motion from "./_home/Motion.astro";
import { faqJsonLd, installCopyScript } from "./_home/shared.ts";
import Calculator from "./_pricing/Calculator.astro";
import Costs from "./_pricing/Costs.astro";
import Hero from "./_pricing/Hero.astro";
import Hosts from "./_pricing/Hosts.astro";
import { faq } from "./_pricing/prices.ts";
import Sponsor from "./_pricing/Sponsor.astro";

const { config } = data;
const pageTitle = "Blume pricing: free and open source";
const pageDescription =
  "Blume is free and open source, with no plans, seats, or credits. See what hosting, an AI assistant, and an MCP server cost on your own host, next to Mintlify.";
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{ description: pageDescription, route: "/pricing", title: pageTitle }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  structuredDataEnabled={config.structuredData}
  themeMode={config.theme.mode}
  x={config.x}
>
  <div
    class="mx-auto grid max-w-[1400px] gap-24 px-6 pb-20 sm:pb-24 lg:gap-32 xl:gap-40"
  >
    <Hero />

    <Calculator />

    <Costs />

    <Hosts />

    <Fit tool={compareTool("mintlify")} />

    <Sponsor />

    <Faq items={faq} tagline="About what Blume costs to run." />

    <InstallCta />
  </div>
  <!-- After the sections, so their reveal containers exist when it arms -->
  <Motion />
  <script is:inline set:html={installCopyScript} />
  <script is:inline set:html={faqJsonLd(faq)} type="application/ld+json" />
  <Footer slot="footer" />
</PageLayout>
