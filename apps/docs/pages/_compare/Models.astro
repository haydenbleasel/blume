---
// "Three ways to ship docs." — where Blume sits among the kinds of tools it's
// compared with: a hosted platform, a framework you own, and Blume. A tray of
// three columns, each with the marks of the tools in that camp, its name, and
// the same four answers; Blume's column is the raised white card. From `lg`
// each card is a subgrid of the tray's rows, so the marks, the headings, and
// every answer row line up across the three columns however they wrap. The
// camps come from each tool's `kind` in _compare/tools.ts, so a new entry
// lands here too. Claims here are about the camp, so keep them true of every
// tool in it (see the per-tool pages in tools.ts for the specifics).
import data from "blume:data";
import SectionHeading from "../_home/SectionHeading.astro";
import Tray from "../_home/Tray.astro";
import { withUniqueIds } from "../_home/migrate-sources.ts";
import type { CompareTool } from "./tools.ts";
import { tools } from "./tools.ts";

const { config } = data;
const blumeLogo = config.logo?.svg ?? "";
const camp = (kind: CompareTool["kind"]) => {
  const members = tools.filter((tool) => tool.kind === kind);
  return {
    marks: members.map((tool) => tool.source.logo),
    tools: members.map((tool) => tool.source.name).join(", "),
  };
};

const models = [
  {
    answers: [
      "Your content, in their web editor or synced from Git",
      "The vendor's cloud; self-hosting only on some enterprise plans",
      "A free tier or trial, then paid plans, with AI often extra",
      "Whatever the vendor builds in, often gated by plan or credits",
    ],
    name: "A hosted platform",
    raised: false,
    ...camp("hosted"),
  },
  {
    answers: [
      "Your content, plus the project around it",
      "Any host you choose",
      "Free and open source",
      "Mostly plugins, or route code that lives in your app",
    ],
    name: "A framework you own",
    raised: false,
    ...camp("framework"),
  },
  {
    answers: [
      "Just your content",
      "Any host, as static files or a server",
      "Free and open source",
      "llms.txt, Markdown mirrors, and a JSON API by default; an MCP server and your skills when you opt in",
    ],
    marks: [blumeLogo],
    name: "Blume",
    raised: true,
    tools: "The framework is the template",
  },
];

const questions = ["You maintain", "It runs on", "It costs", "Agent features"];
---

<section class="flex flex-col gap-12">
  <SectionHeading
    tagline="Blume gives you the platform's polish with none of the app."
    title="Three ways to ship docs."
  />
  <Tray innerClass="p-2">
    <div class="grid gap-2 lg:grid-cols-3" data-reveal>
      {
        models.map((model, index) => (
          <article
            class:list={[
              "reveal-rise flex flex-col gap-8 rounded-[20px] p-6 sm:p-8 lg:row-span-6 lg:grid lg:grid-rows-subgrid lg:gap-0",
              model.raised &&
                "bg-background shadow-[0_12px_32px_-12px_rgb(28_40_64/0.25)] ring-1 ring-foreground/5 dark:shadow-none",
            ]}
            style={`--reveal-delay: ${index * 100}ms`}
          >
            <div class="flex flex-col gap-4 lg:contents">
              <div
                aria-hidden="true"
                class="flex flex-wrap items-center gap-2 lg:self-start"
              >
                {model.marks.map((mark) => (
                  <span
                    class:list={[
                      "inline-flex h-6 shrink-0 text-foreground [&>svg]:h-full [&>svg]:w-auto",
                      model.raised ? "" : "aspect-square",
                    ]}
                    set:html={withUniqueIds(mark)}
                  />
                ))}
              </div>
              <div class="lg:pt-4 lg:pb-8">
                <h3 class="font-medium text-xl tracking-normal">{model.name}</h3>
                <p class="mt-1 text-muted-foreground text-sm">{model.tools}</p>
              </div>
            </div>
            <dl class="flex flex-col divide-y divide-border border-border border-t lg:row-span-4 lg:grid lg:grid-rows-subgrid lg:gap-0">
              {questions.map((question, row) => (
                <div class="flex flex-col gap-1 py-4">
                  <dt class="text-muted-foreground text-xs">{question}</dt>
                  <dd
                    class:list={[
                      "text-pretty text-base sm:text-sm",
                      model.raised ? "text-foreground" : "text-muted-foreground",
                    ]}
                  >
                    {model.answers[row]}
                  </dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
  </Tray>
</section>
