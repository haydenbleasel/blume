---
// A compare page for one tool, rendered from its entry in tools.ts: the
// "Blume vs <tool>" hero with its at-a-glance table, the agent-readiness
// scores when both sites were scanned, what the migration carries over, where
// the other tool fits better, the homepage's Migrate picker opened on this
// tool, questions (also emitted as FAQPage JSON-LD), and the install CTA.
// Built in the homepage's design language. Each tool has its own static route
// file under compare/ rather than one `[tool]` route, so every page gets a
// generated OG card and a sitemap entry like any other static page.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Footer from "../_home/Footer.astro";
import InstallCta from "../_home/InstallCta.astro";
import Migrate from "../_home/Migrate.astro";
import Motion from "../_home/Motion.astro";
import { faqJsonLd, installCopyScript } from "../_home/shared.ts";
import CarryOver from "./CarryOver.astro";
import Faq from "./Faq.astro";
import Fit from "./Fit.astro";
import Hero from "./Hero.astro";
import Scores from "./Scores.astro";
import type { CompareTool } from "./tools.ts";

interface Props {
  tool: CompareTool;
}

const { tool } = Astro.props;
const { config } = data;
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{
    description: tool.meta.description,
    route: `/compare/${tool.id}`,
    title: tool.meta.title,
  }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  structuredDataEnabled={config.structuredData}
  themeMode={config.theme.mode}
  x={config.x}
>
  <div
    class="mx-auto grid max-w-[1400px] gap-24 px-6 pb-20 sm:pb-24 lg:gap-32 xl:gap-40"
  >
    <Hero tool={tool} />

    {tool.scores && <Scores scores={tool.scores} tool={tool} />}

    <CarryOver tool={tool} />

    <Fit tool={tool} />

    <div class="scroll-mt-24" id="migrate">
      <Migrate initial={tool.id} />
    </div>

    <Faq
      items={tool.faq}
      tagline={`About moving from ${tool.source.name} to Blume.`}
    />

    <InstallCta />
  </div>
  <!-- After the sections, so their reveal containers exist when it arms -->
  <Motion />
  <script is:inline set:html={installCopyScript} />
  <script
    is:inline
    set:html={faqJsonLd(tool.faq)}
    type="application/ld+json"
  />
  <Footer slot="footer" />
</PageLayout>
