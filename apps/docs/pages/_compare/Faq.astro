---
// Frequently asked questions for a compare page or /pricing: a split with the
// two-tone heading on the left and the questions as native disclosures on the
// right (the first open), so the answers are in the HTML for readers,
// crawlers, and agents alike. The page also emits them as FAQPage JSON-LD
// (`faqJsonLd` in _home/shared.ts).
import SectionHeading from "../_home/SectionHeading.astro";
import { glyph, inlineMarkup } from "../_home/shared.ts";

interface Props {
  items: { answer: string; question: string }[];
  tagline: string;
}

const { items, tagline } = Astro.props;
const chevron = glyph("chevron-down");
---

<section class="grid items-start gap-x-16 gap-y-10 lg:grid-cols-2">
  <SectionHeading
    tagline={tagline}
    title="Questions, answered."
  />
  <div class="divide-y divide-border border-border border-y">
    {
      items.map((item, index) => (
        <details class="group py-2" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 font-medium text-base text-foreground sm:text-sm [&::-webkit-details-marker]:hidden">
            {item.question}
            <svg
              aria-hidden="true"
              class="size-4 shrink-0 text-muted-foreground group-open:rotate-180"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              set:html={chevron}
            />
          </summary>
          <p
            class="max-w-[60ch] pb-4 text-pretty text-base text-muted-foreground sm:text-sm"
            set:html={inlineMarkup(item.answer)}
          />
        </details>
      ))
    }
  </div>
</section>
