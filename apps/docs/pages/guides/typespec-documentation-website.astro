// Publish API documentation from a TypeSpec definition: checked against the
// OpenAPI, navigation, folder meta, versioning, validate, audit, and
// deployment docs, and on main against the OpenAPI loader and its
// diagnostics (openapi/source.ts, including the dev-only warning for an
// unloadable spec), routes and tag order (openapi/model.ts operationKey,
// operationCollector, extractOperations), the title and sidebar label
// fallbacks (openapi/render-mdx.ts), example resolution
// (components/openapi/helpers.ts, operation-model.ts, playground-schema.ts),
// the agent Markdown serializers (ai/openapi-components.ts), `blume init`
// (cli/commands/init.ts, cli/init/scaffold.ts), and the source-vs-user folder
// meta merge (core/project-graph.ts). TypeSpec side: the @typespec/openapi3
// 1.16.0 README (emitter options), the compiler, http, openapi, and
// versioning decorator declarations in node_modules, the packages' engines
// and peer dependencies, and the `rest` template in microsoft/typespec at
// 86a4ad18744c2e5d1eb54fd09ac56e2be7e84a9d
// (packages/compiler/templates/rest/main.tsp), byte-identical to what
// `tsp init --template rest` wrote from @typespec/compiler 1.16.0.
//
// Ran end to end on 2026-10-05, Node 24.14.1 and npm 11.11.0, in a fresh
// folder outside the repo: every command and file on this page, in order,
// extracted from this page and compared byte for byte with what was built.
// TypeSpec 1.16.0 (@typespec/compiler, http, openapi, openapi3) and
// @typespec/versioning 0.86.0 from npm; Blume 2.1.3 symlinked from main into
// node_modules and run by path in place of `npx blume` and
// `npm install blume`. Results: the template spec as is (the widgets-list
// URLs and GET /widgets titles in the table, BLUME_NAV_DUPLICATE_LABEL,
// validate --strict exit 1); the final definition (the jq output shown,
// `npm run build`, validate --strict exit 0, audit 0 errors and 0 warnings,
// `blume preview` with curl: 200 on every route in the table, 404 on the old
// widgets-list URL, page text checked for titles, auth, samples, and
// examples); `tsp compile . --watch` beside `blume dev` updating a page
// without a restart; the workflow's steps run locally after a git commit
// (two compiles wrote identical bytes; the freshness check passed, failed
// with the diff shown after a `label` property was added, and passed again);
// and the versioned project (two files, the old openapi.json left behind,
// validate listing the three stale links, audit at 35 warnings without
// `noindex` and 0 with `noindex` alone, the glob freshness check). Also
// probed: inline @tagMetadata reversing the tag order; a model-level @example
// putting the read-only id in Create a widget's request sample;
// @opExample rejecting a Widget body without id and a missing update body;
// no request example on a merge-patch body (and one on a Create<W> body);
// parameter examples only with experimental-parameter-examples, and none
// from @example on a path parameter; operations outside an interface getting
// bare operation IDs; @doc and doc comments both writing `description`;
// @versioned overriding @info's version; 3.0.0 and 3.2.0 output building the
// same pages; several openapi-versions writing per-version folders; the tag
// meta.ts with and without title and order; validate failing with
// BLUME_BROKEN_LINK after an @operationId was removed; and
// BLUME_OPENAPI_UNAVAILABLE without openapi.json. Not run: `npm ci` (Blume
// was linked, not installed), the workflow on GitHub Actions, and a deploy.
//
// Independent review, same versions, in copies of that project: recompiled
// (byte-identical openapi.json), build, validate --strict exit 0, audit 0
// warnings, and the page text of Get, Create, and Update a widget and the
// overview; the template spec again (the table's URLs, titles, and labels,
// BLUME_NAV_DUPLICATE_LABEL, validate --strict exit 1); one summary renamed,
// which showed the sidebar sorts a tag's operations by label
// (core/navigation.ts sortNodes), not by URL, so both places that said URL
// were fixed; the versioned audit (35 warnings without the three options:
// duplicate titles and meta descriptions, identical pages without a
// canonical, and an orphan /api/v1; 0 with noindex alone); `blume build`
// exiting 1 on BLUME_OPENAPI_UNAVAILABLE; both @opExample missing-property
// errors and Create<Widget>; inline @tagMetadata reversing the tags; and an
// @example on a path parameter not being emitted. tspconfig.yaml now keeps
// the template's `kind: project` line, which the e2e run didn't have; a
// compile with it wrote byte-identical output.
import CodeBlock from "blume/components/content/CodeBlock.astro";
import GuidePage from "../_guides/GuidePage.astro";
import { guideById } from "../_guides/guides.ts";

const mainTsp = `import "@typespec/http";
import "@typespec/openapi";

using Http;
using OpenAPI;

/**
 * Create, update, and analyze the widgets in your Acme account.
 * Every request needs an API key, sent as a bearer token.
 */
@service(#{ title: "Widget Service" })
@info(#{ version: "1.0.0" })
@server("https://api.widgets.example", "Production")
@useAuth(BearerAuth)
@tagMetadata(#[
  #{
    name: "Widgets",
    description: "Create, read, update, and delete widgets.",
  },
  #{
    name: "Analysis",
    description: "Run checks on a widget you already created.",
  }
])
namespace WidgetService;

/** A widget in your account. */
model Widget {
  /** The widget's ID, set by the API when you create it. */
  @visibility(Lifecycle.Read)
  @example("wdg_8f2k")
  id: string;

  /** The widget's weight, in grams. */
  @minValue(1)
  @example(120)
  weight: int32;

  /** The widget's color. */
  @example("red")
  color: "red" | "blue";
}

/** A page of widgets. */
model WidgetList {
  /** The widgets on this page. */
  items: Widget[];
}

/** The error every operation returns when a request fails. */
@error
model Error {
  /** A numeric code for the error. */
  @example(404)
  code: int32;

  /** What went wrong, in a sentence. */
  @example("No widget has that ID.")
  message: string;
}

/** The result of analyzing a widget. */
model AnalyzeResult {
  /** The ID of the widget that was analyzed. */
  id: string;

  /** What the analysis found. */
  analysis: string;
}

@route("/widgets")
@tag("Widgets")
interface Widgets {
  /** Returns every widget in your account, newest first. */
  @summary("List widgets")
  @operationId("listWidgets")
  @get
  list(): WidgetList | Error;

  /**
   * Returns one widget by its ID, with its current weight and color.
   * @param id The widget's ID, from the response to Create a widget.
   */
  @summary("Get a widget")
  @operationId("getWidget")
  @returnsDoc("The widget.")
  @opExample(#{
    parameters: #{ id: "wdg_8f2k" },
    returnType: #{ id: "wdg_8f2k", weight: 120, color: "red" },
  })
  @get
  read(@path id: string): Widget | Error;

  /** Creates a widget and returns it with the ID the API assigned. */
  @summary("Create a widget")
  @operationId("createWidget")
  @post
  create(@body body: Widget): Widget | Error;

  /**
   * Changes the fields you send and leaves the rest as they are.
   * @param id The ID of the widget to update.
   */
  @summary("Update a widget")
  @operationId("updateWidget")
  @opExample(#{ parameters: #{ id: "wdg_8f2k", body: #{ weight: 150 } } })
  @patch
  update(@path id: string, @body body: MergePatchUpdate<Widget>):
    | Widget
    | Error;

  /**
   * Deletes a widget. This can't be undone.
   * @param id The ID of the widget to delete.
   */
  @summary("Delete a widget")
  @operationId("deleteWidget")
  @returnsDoc("The widget is deleted.")
  @opExample(#{ parameters: #{ id: "wdg_8f2k" } })
  @delete
  delete(@path id: string): void | Error;
}

@route("/widgets/{id}/analyze")
@tag("Analysis")
interface Analysis {
  /**
   * Checks a widget's weight and color against your account's rules.
   * @param id The ID of the widget to analyze.
   */
  @summary("Analyze a widget")
  @operationId("analyzeWidget")
  @opExample(#{
    parameters: #{ id: "wdg_8f2k" },
    returnType: #{
      id: "wdg_8f2k",
      analysis: "Within your account's weight limit.",
    },
  })
  @post
  analyze(@path id: string): AnalyzeResult | Error;
}`;

const indexMdx = `---
title: Introduction
description: Store widgets, update them, and run analysis on them with the Widget Service API, using an API key and any HTTP client.
---

The Widget Service API stores the widgets in your Acme account and checks them
against your account's rules.

- [Quickstart](/quickstart) takes you from an API key to your first analyzed widget.
- The [API reference](/api) lists every operation, generated from the API's TypeSpec definition.`;

const quickstartMdx = `---
title: Quickstart
description: Authenticate with an API key, create your first widget with the Widget Service API, and run an analysis on it.
---

Every request needs an API key, sent in the \`Authorization\` header as a bearer
token. Set it in your shell first:

\`\`\`bash
export WIDGETS_API_KEY="your-api-key"
\`\`\`

## Create a widget

Send its weight and color to [Create a widget](/api/widgets/create-widget):

\`\`\`bash
curl https://api.widgets.example/widgets \\
  -H "Authorization: Bearer $WIDGETS_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{"weight":120,"color":"red"}'
\`\`\`

The response is the widget, with the ID the API assigned:

\`\`\`json
{ "id": "wdg_8f2k", "weight": 120, "color": "red" }
\`\`\`

## Analyze it

Pass the ID to [Analyze a widget](/api/analysis/analyze-widget):

\`\`\`bash
curl -X POST https://api.widgets.example/widgets/wdg_8f2k/analyze \\
  -H "Authorization: Bearer $WIDGETS_API_KEY"
\`\`\`

## Handle errors

A failed request returns an error object with a numeric \`code\` and a
\`message\`. Every operation's page lists it under its responses.`;

