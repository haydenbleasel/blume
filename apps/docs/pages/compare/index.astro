---
// The compare index (/compare): a directory of the per-tool pages (each card
// from _compare/tools.ts, grouped into hosted platforms and frameworks you
// own), where Blume sits among those two camps, the homepage's Migrate picker,
// and the install CTA.
// Built in the homepage's design language, like the pages it links to.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Directory from "../_compare/Directory.astro";
import Models from "../_compare/Models.astro";
import { tools } from "../_compare/tools.ts";
import Footer from "../_home/Footer.astro";
import InstallCta from "../_home/InstallCta.astro";
import Migrate from "../_home/Migrate.astro";
import Motion from "../_home/Motion.astro";
import { installCopyScript } from "../_home/shared.ts";

const { config } = data;
// Every tool's name is too long for a search result, so the title and
// description name the first few in tools.ts order and stand in for the rest.
const leading = tools.slice(0, 3).map((tool) => tool.source.name);
const pageTitle = `Blume vs ${leading.join(", ")}, and more`;
const pageDescription = `How Blume compares with ${leading.join(", ")}, and ${tools.length - leading.length} other docs tools on price, hosting, agent features, API references, and migration.`;
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{ description: pageDescription, route: "/compare", title: pageTitle }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  structuredDataEnabled={config.structuredData}
  themeMode={config.theme.mode}
  x={config.x}
>
  <div
    class="mx-auto grid max-w-[1400px] gap-24 px-6 pb-20 sm:pb-24 lg:gap-32 xl:gap-40"
  >
    <Directory />

    <Models />

    <div class="scroll-mt-24" id="migrate">
      <Migrate />
    </div>

    <InstallCta />
  </div>
  <!-- After the sections, so their reveal containers exist when it arms -->
  <Motion />
  <script is:inline set:html={installCopyScript} />
  <Footer slot="footer" />
</PageLayout>
