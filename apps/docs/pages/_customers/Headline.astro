---
// A story headline's text with its hyphenated words kept whole, so a narrow
// panel never breaks "Mintlify-level" after the hyphen (see headlineParts).
import { headlineParts } from "./customers.ts";

interface Props {
  text: string;
}

const { text } = Astro.props;
---

{
  headlineParts(text).map((part) =>
    part.whole ? <span class="whitespace-nowrap">{part.text}</span> : part.text
  )
}
