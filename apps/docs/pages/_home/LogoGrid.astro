---
// Customer logos — one row of faded wordmarks drifting past as a marquee,
// shown right under the product preview, so the strip never wraps however
// many customers it holds. Each links to that customer's Blume-built site.
// The list lives in _customers/customers.ts, shared with the /customers logo
// wall. The wordmarks are single-color SVG files in `public/logos/`, drawn as CSS
// masks over `currentColor` rather than inlined: inlined (and doubled for the
// loop) they were a third of the homepage's HTML, which pulled its
// text-to-markup ratio under what agent-readiness scanners expect. The mask
// keeps them theme-aware — the muted foreground at half strength, so the strip
// reads quietly, brightening on hover — and each mark's `width`/`height` (its
// viewBox) sets the aspect ratio so the row lays out before the files load.
// The link carries the accessible name; the mark stays decorative. The row
// renders twice so the loop is seamless; the copy is
// hidden from assistive tech and the tab order. Hover or focus pauses it, and
// reduced motion swaps it for a static, centered wrap of the first row.
import { NEW_TAB_ATTRS } from "blume/core/new-tab.ts";
import { logoWall } from "../_customers/customers.ts";
---

<!-- Logo marquee: two identical rows sliding left by their own width. -->
<section data-logos>
  <!-- Visually the strip speaks for itself, but keep the heading and
       summary for assistive tech and search engines. -->
  <h2 class="sr-only">You're in good company.</h2>
  <p class="sr-only">
    Companies and open-source libraries are moving their docs to Blume.
  </p>
  <div
    class="flex overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)] motion-reduce:[mask-image:none]"
  >
    {
      [false, true].map((copy) => (
        <div
          aria-hidden={copy ? "true" : undefined}
          class:list={[
            "logo-marquee flex shrink-0 items-center gap-x-16 pr-16 sm:gap-x-20 sm:pr-20",
            copy
              ? "motion-reduce:hidden"
              : "motion-reduce:w-full motion-reduce:shrink motion-reduce:flex-wrap motion-reduce:justify-center motion-reduce:gap-y-10 motion-reduce:pr-0",
          ]}
        >
          {logoWall.map((customer) => (
            <a
              aria-label={customer.name}
              class="flex shrink-0 items-center justify-center text-muted-foreground/50 hover:text-foreground"
              href={customer.href}
              tabindex={copy ? -1 : undefined}
              {...NEW_TAB_ATTRS}
            >
              <span
                aria-hidden="true"
                class="logo-mark block h-6 bg-current sm:h-7"
                style={`aspect-ratio: ${customer.logo.width} / ${customer.logo.height}; --logo: url(${customer.logo.src})`}
              />
            </a>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  @keyframes logo-marquee {
    to {
      transform: translateX(-100%);
    }
  }

  .logo-marquee {
    animation: logo-marquee 50s linear infinite;
  }

  .logo-mark {
    mask: var(--logo) center / contain no-repeat;
  }

  [data-logos]:hover .logo-marquee,
  [data-logos]:focus-within .logo-marquee {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-marquee {
      animation: none;
    }
  }
</style>
