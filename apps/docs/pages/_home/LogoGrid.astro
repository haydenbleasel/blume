<!-- Logo grid: bordered cells of customer wordmarks, right under the preview. -->
<section class="mx-auto w-full max-w-5xl">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-balance font-medium text-3xl sm:text-4xl">
      You're in good company.
    </h2>
    <p class="mt-4 text-balance text-muted-foreground">
      Companies and open source libraries are moving their docs to Blume.
    </p>
  </div>
  <div
    class="mt-12 grid grid-cols-2 divide-x divide-y divide-border border-border border-t border-l sm:grid-cols-3 lg:grid-cols-4"
  >
    {
      logos.map((logo) => (
        <a
          aria-label={logo.name}
          class="flex aspect-video w-full items-center justify-center border-border p-8 text-muted-foreground transition-colors last:border-r last:border-b hover:text-foreground md:p-10"
          href={logo.href}
          rel="noopener noreferrer"
          set:html={logo.svg}
          target="_blank"
        />
      ))
    }
  </div>
</section>
