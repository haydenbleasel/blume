---
// Sponsors, as a closing credit under the CTA: the thank-you and sponsor link
// on the left, the wordmarks (SponsorLogos) on the right, over a hairline into
// the footer.
import SponsorLogos from "./SponsorLogos.astro";
import TextLink from "./TextLink.astro";
---

<section
  class="flex flex-col gap-8 border-border border-b pb-16 md:flex-row md:items-center md:justify-between"
>
  <div class="flex flex-col items-start gap-3">
    <h2 class="font-medium text-xl">Supported by our sponsors.</h2>
    <p class="max-w-[56ch] text-pretty text-muted-foreground">
      Blume is community-driven and free forever, thanks to these companies.
    </p>
    <TextLink external href="https://github.com/sponsors/haydenbleasel">
      Become a sponsor
    </TextLink>
  </div>
  <SponsorLogos />
</section>
