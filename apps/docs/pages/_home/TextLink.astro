---
// The page's secondary action: medium-weight text with a trailing chevron,
// matching the agent-native section's links. `inverse` is the white take for
// the dark CLI panel and the cornflower CTA.
import { NEW_TAB_ATTRS } from "blume/core/new-tab.ts";
import { glyph } from "./shared.ts";

interface Props {
  class?: string;
  external?: boolean;
  href: string;
  tone?: "accent" | "inverse";
}

const { class: className, external = false, href, tone = "accent" } =
  Astro.props;
---

<a
  class:list={[
    "inline-flex items-center gap-1 whitespace-nowrap font-medium text-sm",
    tone === "inverse"
      ? "text-white/80 hover:text-white"
      : "text-accent hover:text-foreground",
    className,
  ]}
  href={href}
  {...(external ? NEW_TAB_ATTRS : {})}
>
  <slot />
  <svg
    aria-hidden="true"
    class="size-3.5 shrink-0"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    viewBox="0 0 24 24"
    set:html={glyph("chevron-right")}
  />
</a>
