---
// Agent-native: how useblume.dev scores on the two independent agent-readiness
// scanners — a two-tone heading with a docs link, then one muted card per
// scanner (mark and name with a report link, a half-circle gauge of the
// score, then a leaderboard of useblume.dev against the competitors, each a
// bar that grows in as the numbers count up). The gauge arc is an SVG path whose
// dash length is the score's share of the arc's length over a track in the
// border color; the score sits inside the arc as HTML so it uses the page's
// type, and competitors' scores sit on the same arc as dots at their angle,
// each with a hover/focus tooltip naming them.
import { NEW_TAB_ATTRS } from "blume/core/new-tab.ts";
import SectionHeading from "./SectionHeading.astro";
import { glyph } from "./shared.ts";
import TextLink from "./TextLink.astro";

const scores = [
  {
    by: "Vercel",
    href: "https://is-agentic.com/scan/useblume.dev",
    logo: '<svg class="size-full" viewBox="0 0 76 65" xmlns="http://www.w3.org/2000/svg"><path d="M37.5274 0L75.0548 65H0L37.5274 0Z" fill="currentColor"/></svg>',
    name: "is-agentic.com",
    others: [
      { name: "Mintlify", score: 78 },
      { name: "Fumadocs", score: 63 },
    ],
    score: 100,
  },
  {
    by: "Cloudflare",
    href: "https://isitagentready.com/useblume.dev",
    logo: '<svg class="size-full" viewBox="50 5 50 18" xmlns="http://www.w3.org/2000/svg"><path d="M84.2,20.4a2.85546,2.85546,0,0,0-.3-2.6,3.09428,3.09428,0,0,0-2.1-1.1l-17.4-.2c-.1,0-.2-.1-.3-.1a.1875.1875,0,0,1,0-.3c.1-.2.2-.3.4-.3L82,15.6a6.29223,6.29223,0,0,0,5.1-3.8l1-2.6c0-.1.1-.2,0-.3A11.39646,11.39646,0,0,0,66.2,7.7a5.45941,5.45941,0,0,0-3.6-1A5.20936,5.20936,0,0,0,58,11.3a5.46262,5.46262,0,0,0,.1,1.8A7.30177,7.30177,0,0,0,51,20.4a4.102,4.102,0,0,0,.1,1.1.3193.3193,0,0,0,.3.3H83.5c.2,0,.4-.1.4-.3Z" fill="#f48120"/><path d="M89.7,9.2h-.5c-.1,0-.2.1-.3.2l-.7,2.4a2.85546,2.85546,0,0,0,.3,2.6,3.09428,3.09428,0,0,0,2.1,1.1l3.7.2c.1,0,.2.1.3.1a.1875.1875,0,0,1,0,.3c-.1.2-.2.3-.4.3l-3.8.2a6.29223,6.29223,0,0,0-5.1,3.8l-.2.9c-.1.1,0,.3.2.3H98.5a.26517.26517,0,0,0,.3-.3,10.87184,10.87184,0,0,0,.4-2.6,9.56045,9.56045,0,0,0-9.5-9.5" fill="#faad3f"/></svg>',
    name: "isitagentready.com",
    others: [
      { name: "Mintlify", score: 40 },
      { name: "Fumadocs", score: 20 },
    ],
    score: 80,
  },
];

// Arc geometry: a 120-by-68 box holds a half circle of 52-unit radius centered
// at (60, 60), leaving room for the 10-unit stroke and its round caps.
const radius = 52;
const width = 120;
const height = 68;
const arcPath = `M ${60 - radius} 60 A ${radius} ${radius} 0 0 1 ${60 + radius} 60`;
const arcLength = Math.PI * radius;

// On view the arcs draw in (the second card a beat behind the first) and the
// scores count up; the arc is a full-length dash pulled back by its dash
// offset, with a gap long enough that the round cap hides when it's empty.
// The competitor dots pop in as the arc sweeps past them: the arc eases out
// cubically, so it reaches a fraction `f` of its sweep at 1 − ∛(1 − f) of
// the duration.
const arcDuration = 1400;
const cardDelay = (index: number): number => index * 180;
const arcStyle = (score: number, index: number): string =>
  `--gauge-len: ${arcLength}px; --gauge-offset: ${arcLength * (1 - score / 100)}px; --gauge-delay: ${cardDelay(index)}ms;`;
const dotDelay = (other: number, score: number, index: number): number =>
  Math.round(cardDelay(index) + arcDuration * (1 - Math.cbrt(1 - other / score)));

// Where a score lands on the arc, as percentages of the box, so an HTML dot
// can sit on the stroke: from the left end, over the top, to the right end.
const dotPosition = (score: number): string => {
  const angle = (score / 100) * Math.PI;
  const x = ((60 - radius * Math.cos(angle)) / width) * 100;
  const y = ((60 - radius * Math.sin(angle)) / height) * 100;
  return `left: ${x}%; top: ${y}%;`;
};

const docsHref = "/docs/discoverability/agent-discovery";
const chevronRight = glyph("chevron-right");
const link =
  "inline-flex items-center gap-1 font-medium text-accent text-sm transition-colors hover:text-foreground [&>svg]:size-3.5";
---

<!-- Agent-native: heading, then a card per scanner and the scan date. -->
<section class="flex flex-col gap-12" data-reveal>
  <SectionHeading
    tagline="Scored by two independent scanners."
    title="The agent-native documentation framework."
  >
    <TextLink href={docsHref}>Read the docs</TextLink>
  </SectionHeading>

  <div class="flex flex-col gap-3">
    <div class="grid gap-4 md:grid-cols-2">
      {
        scores.map((item, index) => (
          <article class="flex flex-col gap-8 rounded-[28px] bg-muted p-6 inset-ring inset-ring-foreground/5 sm:p-8">
            <div class="flex items-center justify-between gap-4">
              <p class="flex items-center gap-2.5">
                <span
                  aria-hidden="true"
                  class="inline-flex size-5 shrink-0 items-center justify-center text-foreground"
                  set:html={item.logo}
                />
                <span class="font-medium">
                  {item.name}
                  <span class="sr-only">by {item.by}</span>
                </span>
              </p>
              <a
                class={link}
                href={item.href}
                {...NEW_TAB_ATTRS}
              >
                View report
                <svg
                  aria-hidden="true"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  set:html={chevronRight}
                />
              </a>
            </div>
            <div class="flex flex-1 items-center justify-center py-2">
              <div class="relative aspect-[120/68] w-56 lg:w-72">
                <svg
                  aria-hidden="true"
                  class="size-full"
                  fill="none"
                  viewBox={`0 0 ${width} ${height}`}
                >
                  <path
                    class="stroke-border"
                    d={arcPath}
                    stroke-linecap="round"
                    stroke-width="10"
                  />
                  <path
                    class="gauge-arc stroke-accent"
                    d={arcPath}
                    stroke-dasharray={`${arcLength} ${arcLength + 20}`}
                    stroke-linecap="round"
                    stroke-width="10"
                    style={arcStyle(item.score, index)}
                  />
                </svg>
                <!-- The <dl> below reads the score out; this is its picture. -->
                <p
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-x-0 bottom-0 flex justify-center font-medium text-5xl leading-none tabular-nums lg:text-6xl"
                  data-count-delay={cardDelay(index)}
                  data-count-to={item.score}
                >
                  {item.score}
                </p>
                {item.others.map((other) => (
                  <span
                    aria-label={`${other.name}: ${other.score} out of 100`}
                    class="reveal-pop group absolute size-3.5 -translate-x-1/2 -translate-y-1/2 cursor-default rounded-full bg-foreground ring-2 ring-muted outline-none hover:z-10 focus-visible:z-10 focus-visible:ring-accent"
                    role="img"
                    style={`${dotPosition(other.score)} --reveal-delay: ${dotDelay(other.score, item.score, index)}ms;`}
                    tabindex="0"
                  >
                    <span
                      aria-hidden="true"
                      class="-translate-x-1/2 pointer-events-none absolute bottom-full left-1/2 mb-2 hidden whitespace-nowrap rounded-md bg-foreground px-2 py-1 text-background text-xs group-focus-visible:block group-hover:block"
                    >
                      {other.name} {other.score}/100
                    </span>
                  </span>
                ))}
              </div>
            </div>
            <!-- Leaderboard: a row per site, each bar at its score's width. -->
            <dl class="flex flex-col gap-3">
              {[
                { name: "useblume.dev", score: item.score, strong: true },
                ...item.others.map((other) => ({ ...other, strong: false })),
              ].map((row, rank) => (
                <div class="grid grid-cols-[7rem_minmax(0,1fr)_4.5rem] items-center gap-4">
                  <dt
                    class:list={[
                      "truncate text-base sm:text-sm",
                      row.strong
                        ? "font-medium text-foreground"
                        : "text-muted-foreground",
                    ]}
                  >
                    {row.name}
                  </dt>
                  <dd aria-hidden="true" class="h-1.5 overflow-hidden rounded-full bg-border">
                    <div
                      class:list={[
                        "reveal-grow h-full w-(--score) rounded-full",
                        row.strong ? "bg-accent" : "bg-foreground/35",
                      ]}
                      style={`--score: ${row.score}%; --reveal-delay: ${cardDelay(index) + rank * 120}ms`}
                    />
                  </dd>
                  <dd class="text-right text-base tabular-nums sm:text-sm">
                    <span
                      class:list={[
                        row.strong ? "font-medium text-foreground" : "text-muted-foreground",
                      ]}
                      data-count-delay={cardDelay(index)}
                      data-count-to={row.score}
                    >
                      {row.score}
                    </span><span class="text-muted-foreground">/100</span>
                  </dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
    <p class="text-muted-foreground text-xs">
      Scores are as reported by is-agentic.com and isitagentready.com on
      September 20, 2026, and may have changed since.
    </p>
  </div>
</section>

<style>
  .gauge-arc {
    stroke-dashoffset: var(--gauge-offset);
  }

  @media (prefers-reduced-motion: no-preference) {
    .gauge-arc {
      transition: stroke-dashoffset 1.4s cubic-bezier(0.33, 1, 0.68, 1)
        var(--gauge-delay);
    }

    [data-reveal-armed]:not([data-inview]) .gauge-arc {
      stroke-dashoffset: calc(var(--gauge-len) + 12px);
    }
  }
</style>
