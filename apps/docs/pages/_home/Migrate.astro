---
// "Migrate with an agent." — one interactive demo: the headline reads
// "Migrate from [Fumadocs]" where the bracketed brand is a dropdown trigger
// (logo + name + chevron). Picking another source swaps the trigger, the body
// copy, and the `blume migrate <source>` command in step one. With no JS the
// initial source's panels (Fumadocs unless `initial` says otherwise) stay
// visible. The copy buttons reuse the page-level delegated
// `data-blume-copy-install` handler.
import Icon from "blume/components/Icon.astro";
import CommandText from "./CommandText.astro";
import {
  migrateCommand,
  sourceById,
  sources,
  withUniqueIds,
} from "./migrate-sources.ts";
import Tray from "./Tray.astro";

interface Props {
  /** The source the picker opens on (a `sources` id). */
  initial?: string;
}

const { initial = "fumadocs" } = Astro.props;
const active = sourceById(initial);

// The brand menu is a disclosure: the trigger's `aria-expanded` shows or hides
// a group of plain buttons, and the current source's button carries
// `aria-current`. Open/close it, then mirror the chosen button into the
// trigger (logo + label) and reveal its panel. A click outside the picker
// (even elsewhere in the section, like the story or a copy button), Escape,
// or focus tabbing out of the picker closes it. Astro's ClientRouter runs an
// inline script once per session, so this delegates from `document` (bound
// once, guarded by a global flag) and looks the picker up per event, which
// keeps it alive after router swaps replace the section. Closed, the menu is
// `inert`, so its buttons leave the tab order and the accessibility tree (the
// heading reads "Migrate from Fumadocs", not every source); closing hands
// focus back to the trigger first.
const migrateScript = `(()=>{if(window.__blumeMigrate){return;}window.__blumeMigrate=true;const setOpen=(root,o)=>{const trigger=root.querySelector("[data-migrate-trigger]");const menu=root.querySelector("[data-migrate-menu]");if(!o&&menu.contains(document.activeElement)){trigger.focus();}trigger.setAttribute("aria-expanded",String(o));menu.dataset.open=String(o);menu.inert=!o;};const select=(root,id)=>{const options=[...root.querySelectorAll("[data-migrate-option]")];options.forEach((o)=>o.setAttribute("aria-current",String(o.dataset.migrateOption===id)));root.querySelectorAll("[data-migrate-panel]").forEach((p)=>{p.dataset.active=String(p.dataset.migratePanel===id);});const o=options.find((it)=>it.dataset.migrateOption===id);if(o){const trigger=root.querySelector("[data-migrate-trigger]");trigger.querySelector("[data-trigger-label]").textContent=o.dataset.label;trigger.querySelector("[data-trigger-logo]").innerHTML=o.querySelector("[data-option-logo]").innerHTML;}setOpen(root,false);};document.addEventListener("click",(e)=>{const root=document.querySelector("[data-migrate]");const t=e.target;if(!root||!(t instanceof Element)){return;}const trigger=root.querySelector("[data-migrate-trigger]");if(trigger.contains(t)){setOpen(root,trigger.getAttribute("aria-expanded")!=="true");return;}const option=t.closest("[data-migrate-option]");if(option&&root.contains(option)){select(root,option.dataset.migrateOption);return;}if(!root.querySelector("[data-migrate-picker]").contains(t)){setOpen(root,false);}});document.addEventListener("keydown",(e)=>{if(e.key==="Escape"){const root=document.querySelector("[data-migrate]");if(root){setOpen(root,false);}}});document.addEventListener("focusout",(e)=>{const root=document.querySelector("[data-migrate]");const next=e.relatedTarget;if(!root||!(next instanceof Node)){return;}const picker=root.querySelector("[data-migrate-picker]");if(picker.contains(e.target)&&!picker.contains(next)){setOpen(root,false);}});})();`;
---

<!-- Migrate: a tray split in two — the heading itself is the interactive
     brand picker (with that source's story beneath it) on the left, the three
     steps on the right, where step two names the chosen source too. -->
<section data-migrate>
  <Tray innerClass="grid items-start gap-x-16 gap-y-10 p-6 sm:p-10 lg:grid-cols-2 lg:p-12">
    <div>
      <!-- "Migrate from [Brand]" — the trigger is bare inline text (logo +
           name + chevron) with no button chrome; only the hover underline
           hints it's a control. -->
      <div
        aria-level="2"
        class="flex flex-wrap items-center gap-x-3 gap-y-1 text-balance font-display font-medium text-3xl tracking-[-0.05em] sm:text-4xl"
        role="heading"
      >
        <span>Migrate from</span>
          <div class="relative" data-migrate-picker>
            <button
              aria-controls="migrate-menu"
              aria-expanded="false"
              class="group inline-flex cursor-pointer items-center gap-2"
              data-migrate-trigger
              type="button"
            >
              <span
                aria-hidden="true"
                class="inline-flex size-[0.85em] shrink-0 items-center justify-center"
                data-trigger-logo
                set:html={withUniqueIds(active.logo)}
              />
              <span
                class="underline decoration-2 decoration-transparent underline-offset-[6px] transition-colors group-hover:decoration-muted-foreground"
                data-trigger-label
              >
                {active.name}
              </span>
              <svg
                aria-hidden="true"
                class="size-[0.7em] shrink-0 text-muted-foreground transition-transform group-aria-[expanded=true]:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>

            <!-- Brand menu (this keeps its own dropdown chrome) -->
            <div
              aria-label="Choose a docs tool to migrate from"
              class="font-sans pointer-events-none absolute left-0 z-20 mt-3 w-56 translate-y-1 rounded-blume border border-border bg-background p-1.5 text-left font-normal text-base tracking-normal opacity-0 shadow-black/5 shadow-lg transition data-[open=true]:pointer-events-auto data-[open=true]:translate-y-0 data-[open=true]:opacity-100"
              data-migrate-menu
              data-open="false"
              id="migrate-menu"
              inert
              role="group"
            >
              {
                sources.map((source) => (
                  <button
                    aria-current={source.id === active.id ? "true" : "false"}
                    class="group flex w-full items-center gap-3 rounded-md px-3 py-2 text-left text-foreground text-sm transition-colors hover:bg-muted aria-[current=true]:bg-muted"
                    data-label={source.name}
                    data-migrate-option={source.id}
                    type="button"
                  >
                    <span
                      aria-hidden="true"
                      class="flex size-5 shrink-0 items-center justify-center"
                      data-option-logo
                      set:html={withUniqueIds(source.logo)}
                    />
                    <span class="font-medium">{source.name}</span>
                    <svg
                      aria-hidden="true"
                      class="ml-auto size-4 text-accent opacity-0 transition-opacity group-aria-[current=true]:opacity-100"
                      fill="none"
                      height="16"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      width="16"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </button>
                ))
              }
            </div>
          </div>
      </div>

      <!-- Per-source description -->
      {
        sources.map((source) => (
          <p
            class="mt-4 hidden max-w-[56ch] text-pretty text-muted-foreground data-[active=true]:block"
            data-active={source.id === active.id ? "true" : "false"}
            data-migrate-panel={source.id}
          >
            {source.body}
          </p>
        ))
      }
    </div>

    <!-- The same three steps for every source -->
    <ol class="flex flex-col gap-6" data-reveal role="list">
      <li class="reveal-rise flex items-start gap-4">
        <span
          class="inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-background font-medium text-sm tabular-nums ring-1 ring-border"
        >
          1
        </span>
        <div class="min-w-0 flex-1">
          <p class="font-medium text-base sm:text-sm">Run one command in your docs project.</p>
          {
            sources.map((source) => (
              <div
                class="mt-3 hidden items-center gap-3 rounded-blume bg-background py-2 pr-2 pl-4 ring-1 ring-border data-[active=true]:flex"
                data-active={source.id === active.id ? "true" : "false"}
                data-migrate-panel={source.id}
              >
                <span aria-hidden="true" class="select-none font-mono text-muted-foreground text-sm max-sm:hidden">$</span>
                <code class="min-w-0 flex-1 wrap-break-word font-mono text-[0.8125rem] text-foreground">
                  <CommandText command={migrateCommand(source.id)} />
                </code>
                <button
                  aria-label={`Copy the ${source.name} migration command`}
                  class="relative inline-flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground"
                  data-blume-copy-install
                  data-command={migrateCommand(source.id)}
                  type="button"
                >
                  <span
                    aria-hidden="true"
                    class="absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-1/2 pointer-fine:hidden"
                  />
                  <Icon class="size-4" name="copy" size={16} />
                </button>
              </div>
            ))
          }
          <p class="mt-2 text-muted-foreground text-sm">
            Using Claude Code? Swap <code class="whitespace-nowrap font-mono text-foreground">--codex</code> for{" "}
            <code class="whitespace-nowrap font-mono text-foreground">--claude</code>.
          </p>
        </div>
      </li>
      <li class="reveal-rise flex items-start gap-4 [--reveal-delay:150ms]">
        <span
          class="inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-background font-medium text-sm tabular-nums ring-1 ring-border"
        >
          2
        </span>
        <div class="min-w-0 flex-1">
          <p class="font-medium text-base sm:text-sm">Review the agent's edits.</p>
          <p class="mt-1 text-base text-muted-foreground sm:text-sm">
            It follows Blume's migration playbook for{" "}
            {
              sources.map((source) => (
                <span
                  class="hidden data-[active=true]:inline"
                  data-active={source.id === active.id ? "true" : "false"}
                  data-migrate-panel={source.id}
                >
                  {source.name}
                </span>
              ))
            }, rewriting your config and pages in place, so you review the whole move as one diff.
          </p>
        </div>
      </li>
      <li class="reveal-rise flex items-start gap-4 [--reveal-delay:300ms]">
        <span
          class="inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-background font-medium text-sm tabular-nums ring-1 ring-border"
        >
          3
        </span>
        <div class="min-w-0 flex-1">
          <p class="font-medium text-base sm:text-sm">Preview the result.</p>
          <p class="mt-1 text-base text-muted-foreground sm:text-sm">
            Run <code class="font-mono text-foreground">npx blume dev</code>, then
            read the agent's summary of anything it dropped or approximated.
          </p>
        </div>
      </li>
    </ol>
  </Tray>
</section>

<script is:inline set:html={migrateScript} />

<style>
  /* Starlight's mark is gold: starlight.astro.build ships a deeper amber
     gradient on light and a paler one on dark, so mirror both. */
  :global([data-theme="dark"]) [data-migrate] {
    --starlight-gold-1: #fcecc5;
    --starlight-gold-2: #eebd52;
  }
</style>
