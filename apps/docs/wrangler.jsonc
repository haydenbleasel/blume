{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blume-docs",
  "compatibility_date": "2026-09-01",
  // Production hostname, attached as a Workers custom domain (DNS record and
  // certificate are managed by Cloudflare). Other hostnames redirect here via
  // zone Redirect Rules.
  "routes": [{ "pattern": "useblume.dev", "custom_domain": true }],
  // Node built-ins for the MCP server and the Astro runtime.
  "compatibility_flags": ["nodejs_compat"],
  // @astrojs/cloudflare fills in `main` and `assets.directory` when it writes
  // dist/server/wrangler.json; declaring the binding here keeps the adapter
  // from replacing this block.
  "assets": {
    "binding": "ASSETS",
    // Blume prerenders directory-style pages (/docs/usage/index.html) and links
    // to them without a trailing slash. Its run_worker_first rules send every
    // page through the Worker, which serves /docs/usage under either mode, so
    // this only reaches pages the static layer serves itself (when the build
    // couldn't write those rules): there the default auto-trailing-slash mode
    // would 307 /docs/usage to /docs/usage/.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Under an explicit list the static layer answers every request outside
    // it, so a POST to an endpoint left off gets a bare 405. The rules Blume
    // merges in at build time claim every path except fingerprinted assets,
    // the raw .md/.mdx/.txt files, fixed-path JSON, and .well-known, /mcp
    // included; listing it keeps the endpoint on the Worker even if that
    // merge is skipped.
    "run_worker_first": ["/mcp"],
  },
  "observability": {
    "enabled": true,
  },
}
