---
// A hand-written endpoint's Try it panel and request samples, at the head of
// its rail: the page's `<ParamField>`s become the parameters and body of an
// operation model like a spec'd operation's (see `api-page.ts`), so the
// playground and the samples are the OpenAPI reference's own. A page's own
// `<RequestExample>` stands in for the generated samples, and its
// `playground` frontmatter can drop the Try it panel (`simple`).
import data from "blume:data";

import { operationModel } from "../openapi/operation-model.ts";
import Playground from "../openapi/Playground.astro";
import { buildRequest, defaultValues } from "../openapi/request.ts";
import RequestPanel from "../openapi/RequestPanel.astro";
import {
  DEFAULT_SAMPLE_LANGUAGES,
  sampleLanguages,
} from "../openapi/snippets.ts";
import {
  endpointBody,
  endpointParameters,
  endpointSecurity,
  endpointTarget,
  readEndpointSpec,
} from "./api-page.ts";

interface Props {
  /** The endpoint, as the page's plugin wrote it. */
  spec: string;
}

const spec = readEndpointSpec(Astro.props.spec);
const { api } = data.config;
const { path, servers } = endpointTarget(spec.target, api.server);
const model = operationModel({
  method: spec.method,
  parameters: endpointParameters(spec.fields),
  path,
  requestBody: endpointBody(spec.fields),
  schemas: {},
  security: endpointSecurity(spec.authMethod, api.auth),
  servers,
});
const tryIt = spec.playground !== "simple" && api.playground.enabled;
---

{
  tryIt && (
    <Playground
      model={model}
      operation={`${spec.method} ${spec.target}`}
      proxy={api.playground.proxy}
      proxyConfig="api"
      slug="api-pages"
    />
  )
}
{
  !spec.requestExample && (
    <RequestPanel
      languages={sampleLanguages(DEFAULT_SAMPLE_LANGUAGES)}
      responses={{}}
      sample={buildRequest(model, defaultValues(model))}
      schemas={{}}
    />
  )
}
