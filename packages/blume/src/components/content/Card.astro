---
import {
  ADMONITION_ICON,
  ADMONITION_ICON_CLASS,
  admonitionType,
} from "../colors.ts";
import Icon from "../Icon.astro";
import { withBase } from "../islands/base-path.ts";
import { contentHref } from "./base-href.ts";

interface Props {
  title?: string;
  href?: string;
  icon?: string;
  img?: string;
  horizontal?: boolean | string;
  cta?: string;
  arrow?: boolean | string;
  type?: "info" | "warning" | "note" | "tip" | "check" | "danger";
  color?: string;
}

const { arrow, color, cta, horizontal, href, icon, img, title, type } =
  Astro.props;
const Tag = href ? "a" : "div";
const external = href?.startsWith("http");
const isHorizontal = horizontal === true || horizontal === "true";
const showArrow =
  href && arrow === undefined ? external : arrow === true || arrow === "true";
// The typed icon shares Callout's table (and its contrast rule); the surface
// tints are Card's own, a shade lighter than a callout's.
const kind = type ? admonitionType(type) : undefined;
const iconName = icon ?? (kind ? ADMONITION_ICON[kind] : undefined);
const variantClass = {
  danger: "border-red-500/30 bg-red-500/10",
  info: "border-blue-500/30 bg-blue-500/10",
  note: "border-border bg-muted/40",
  success: "border-green-500/30 bg-green-500/10",
  // 6% for the same reason as Callout: the accent defaults to near black, and
  // muted body text on a 10% black tint misses WCAG AA.
  tip: "border-accent/30 bg-accent/6",
  warning: "border-amber-500/30 bg-amber-500/10",
}[kind ?? "note"];
---

<Tag
  class:list={[
    "not-prose block overflow-hidden rounded-blume border text-inherit no-underline! transition-colors hover:no-underline! hover:[&[href]]:border-accent",
    type ? variantClass : "border-border bg-background",
    isHorizontal ? "sm:flex" : "",
  ]}
  data-blume-card
  href={href === undefined ? undefined : contentHref(href)}
  rel={external ? "noreferrer" : undefined}
  target={external ? "_blank" : undefined}
>
  {
    img && (
      <img
        alt=""
        class:list={[
          "w-full object-cover",
          isHorizontal ? "sm:w-40 sm:shrink-0" : "max-h-48",
        ]}
        src={withBase(img)}
      />
    )
  }
  <div class="p-5">
  {
    iconName && (
      <div class:list={["mb-2.5", color ? "" : kind ? ADMONITION_ICON_CLASS[kind] : "text-accent"]}>
        <Icon color={color} name={iconName} size={20} />
      </div>
    )
  }
  {
    title && (
      <p class="mt-0! mb-1.5! flex items-center gap-1.5 font-medium text-foreground">
        {title}
        {showArrow && (
          <Icon class="text-muted-foreground" name="arrow-right" size={14} />
        )}
      </p>
    )
  }
  <div class="font-normal text-muted-foreground text-sm [&>:first-child]:mt-0! [&>:last-child]:mb-0!">
    <slot />
  </div>
  {
    cta && (
      <p class="mt-4! mb-0! flex items-center gap-1.5 font-medium text-accent text-sm">
        {cta}
        {showArrow && <Icon name="arrow-right" size={14} />}
      </p>
    )
  }
  </div>
</Tag>
