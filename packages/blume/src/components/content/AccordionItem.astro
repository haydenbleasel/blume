---
import Icon from "../Icon.astro";
import { componentSlug } from "../slug.ts";

interface Props {
  title: string;
  description?: string;
  defaultOpen?: boolean;
  id?: string;
  icon?: string;
}

const { defaultOpen = false, description, icon, id, title } = Astro.props;
const accordionId = id ?? componentSlug(title);
---

<details
  class="not-prose"
  data-blume-accordion
  id={accordionId}
  open={defaultOpen}
>
  <summary
    class="flex cursor-pointer list-none items-center justify-between p-4 font-medium [&::-webkit-details-marker]:hidden"
  >
    <span class="flex items-start gap-2">
      {
        icon && (
          <Icon
            class="mt-0.5 shrink-0 text-muted-foreground"
            name={icon}
            size={16}
          />
        )
      }
      <span>
        <span class="block">{title}</span>
        {
          description && (
            <span class="block font-normal text-muted-foreground text-sm">
              {description}
            </span>
          )
        }
      </span>
    </span>
    <Icon
      class="text-muted-foreground transition-transform [details[open]>summary_&]:rotate-180"
      name="chevron-down"
      size={16}
    />
  </summary>
  <div class="px-4 pb-4 [&>:first-child]:mt-0! [&>:last-child]:mb-0!">
    <slot />
  </div>
</details>

<script>
  const state = window as Window & { __blumeAccordionHash?: boolean };
  if (!state.__blumeAccordionHash) {
    state.__blumeAccordionHash = true;

    // Repeated titles slug to the same id (e.g. several <Expandable> blocks all
    // defaulting to "show-more"); suffix the later ones so ids stay unique. The
    // first keeps the plain slug, so hash deep-links stay stable.
    const dedupeAccordionIds = () => {
      const seen = new Map<string, number>();
      for (const accordion of document.querySelectorAll<HTMLElement>(
        "[data-blume-accordion][id]"
      )) {
        const count = seen.get(accordion.id) ?? 0;
        seen.set(accordion.id, count + 1);
        if (count > 0) {
          accordion.id = `${accordion.id}-${count + 1}`;
        }
      }
    };

    const accordionFromHash = () => {
      const id = decodeURIComponent(window.location.hash.slice(1));
      if (!id) {
        return null;
      }
      return document.getElementById(id)?.matches("[data-blume-accordion]")
        ? (document.getElementById(id) as HTMLDetailsElement)
        : null;
    };

    const openHashAccordion = () => {
      const accordion = accordionFromHash();
      if (!accordion) {
        return;
      }
      accordion.open = true;
      requestAnimationFrame(() => {
        accordion.scrollIntoView({ block: "start" });
      });
    };

    document.addEventListener(
      "toggle",
      (event) => {
        const accordion = event.target;
        if (
          !(accordion instanceof HTMLDetailsElement) ||
          !accordion.matches("[data-blume-accordion]") ||
          !accordion.open ||
          !accordion.id
        ) {
          return;
        }

        history.replaceState(null, "", `#${encodeURIComponent(accordion.id)}`);
      },
      true
    );

    const init = () => {
      dedupeAccordionIds();
      openHashAccordion();
    };

    window.addEventListener("hashchange", openHashAccordion);
    // Client-router swaps replace the body with fresh server-rendered
    // accordions (duplicate ids and all), so the dedupe + hash-open pass has
    // to run again for each new page.
    document.addEventListener("astro:after-swap", init);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  }
</script>
