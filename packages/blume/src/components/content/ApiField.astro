---
// The row behind `<ParamField>` and `<ResponseField>`: the name with its
// labels, location, type, and flags, the default, then the description from
// the slot, which may hold any MDX, nested fields in an `<Expandable>`
// included. Styled like the OpenAPI reference's rows, so a hand-written API
// page reads like a generated one. Narration skips it, as it does type tables.
import data from "blume:data";

import { referenceStrings } from "../openapi/strings.ts";
import { defaultLabel, isOn } from "./api-field.ts";
import type { FieldValue, FlagProp } from "./api-field.ts";

interface Props {
  default?: FieldValue;
  deprecated?: FlagProp;
  location?: string;
  name?: string;
  post?: string[];
  pre?: string[];
  required?: FlagProp;
  type?: string;
}

const {
  default: value,
  deprecated,
  location,
  name,
  post = [],
  pre = [],
  required,
  type,
} = Astro.props;
const shownDefault = defaultLabel(value);
const strings = referenceStrings(data, Astro.currentLocale);
const labelClass =
  "rounded bg-muted px-1.5 py-0.5 font-medium text-[0.625rem] text-muted-foreground uppercase tracking-wide";
---

<div
  class="border-border border-b py-4"
  data-blume-field
  data-blume-narration="skip"
>
  <div class="not-prose flex flex-wrap items-baseline gap-x-2 gap-y-1">
    {pre.map((label) => <span class={labelClass}>{label}</span>)}
    {name && <code class="font-mono text-foreground text-sm">{name}</code>}
    {post.map((label) => <span class={labelClass}>{label}</span>)}
    {location && <span class={labelClass}>{location}</span>}
    {type && <span class="text-muted-foreground text-xs">{type}</span>}
    {
      isOn(required) && (
        <span class="font-medium text-[0.625rem] text-red-600 uppercase tracking-wide dark:text-red-400">
          {strings.required}
        </span>
      )
    }
    {
      isOn(deprecated) && (
        <span class="font-medium text-[0.625rem] text-muted-foreground uppercase tracking-wide line-through">
          {strings.deprecated}
        </span>
      )
    }
  </div>
  {
    shownDefault !== null && (
      <div class="not-prose mt-2 text-muted-foreground text-xs">
        {strings.default}{" "}
        <code class="rounded bg-muted px-1 py-0.5 text-foreground">
          {shownDefault}
        </code>
      </div>
    )
  }
  {
    Astro.slots.has("default") && (
      <div class="mt-2 text-muted-foreground text-sm [&>:first-child]:mt-0 [&>:last-child]:mb-0">
        <slot />
      </div>
    )
  }
</div>
