---
import { componentSlug } from "../slug.ts";
import { contentHref } from "./base-href.ts";

interface RssMetadata {
  description?: string;
  title?: string;
}

interface Props {
  description?: string;
  /**
   * Link the heading to a dedicated page; falls back to the in-page anchor.
   * A root-relative route gains the composed `deployment.base` + `basePath`
   * prefix at emit time (like a markdown link); anchors and external URLs
   * pass through.
   */
  href?: string;
  id?: string;
  label?: string;
  rss?: RssMetadata;
  tags?: string[] | string;
  title?: string;
}

const {
  description,
  href,
  id: providedId,
  label,
  rss,
  tags,
  title,
} = Astro.props;
const updateLabel = label ?? title ?? "Update";
const id = providedId ?? (componentSlug(updateLabel) || "update");
const tagList = Array.isArray(tags) ? tags : tags ? [tags] : [];
---

<article
  class="not-prose group/update my-8 grid gap-4 border-border border-s ps-4 md:grid-cols-[10rem_minmax(0,1fr)] md:border-s-0 md:ps-0"
  data-blume-update
  data-blume-update-rss-description={rss?.description}
  data-blume-update-rss-title={rss?.title}
  id={id}
>
  <header class="md:border-border md:border-e md:pe-4">
    <a
      class="font-semibold text-foreground text-sm no-underline hover:text-accent"
      href={contentHref(href ?? `#${id}`)}
    >
      {updateLabel}
    </a>
    {
      description && (
        <p class="mt-1! mb-0! text-muted-foreground text-xs leading-5">
          {description}
        </p>
      )
    }
    {
      tagList.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {tagList.map((tag) => (
            <span class="rounded-full bg-muted px-2 py-0.5 font-medium text-muted-foreground text-[0.65rem]">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </header>
  <div class="text-muted-foreground text-sm leading-6 [&_a]:font-medium [&_a]:text-foreground [&_a]:underline [&_code]:rounded [&_code]:bg-muted [&_code]:px-1 [&_h2]:mt-6! [&_h2]:border-t-0! [&_h2]:pt-0! [&_h2]:text-base [&_h2]:font-semibold [&_h2]:text-foreground [&_h3]:mt-4! [&_h3]:font-semibold [&_h3]:text-foreground [&_img]:rounded-blume [&_li]:my-1 [&_p]:my-3! [&>:first-child]:mt-0! [&>:last-child]:mb-0!">
    <slot />
  </div>
</article>

<script>
  const state = window as Window & { __blumeUpdateIds?: boolean };
  if (!state.__blumeUpdateIds) {
    state.__blumeUpdateIds = true;

    // Repeated labels slug to the same id (two "Bug fixes" entries on one
    // changelog page); suffix the later ones so ids stay unique and each
    // entry's self-anchor jumps to itself, not the first duplicate. The first
    // keeps the plain slug, so hash deep-links stay stable. Mirrors the
    // accordion id dedupe in `AccordionItem.astro`.
    const dedupeUpdateIds = () => {
      const seen = new Map<string, number>();
      for (const update of document.querySelectorAll<HTMLElement>(
        "[data-blume-update][id]"
      )) {
        const previous = update.id;
        const count = seen.get(previous) ?? 0;
        seen.set(previous, count + 1);
        if (count === 0) {
          continue;
        }
        update.id = `${previous}-${count + 1}`;
        // Re-point the entry's own header anchor when it targets the old id;
        // an explicit `href` prop (an external permalink) is left alone.
        const anchor = update.querySelector<HTMLAnchorElement>("header a[href]");
        const href = anchor?.getAttribute("href");
        if (anchor && href?.endsWith(`#${previous}`)) {
          anchor.setAttribute(
            "href",
            `${href.slice(0, -previous.length)}${update.id}`
          );
        }
      }
    };

    // Client-router swaps replace the body with fresh server-rendered entries
    // (duplicate ids and all), so the dedupe has to run again for each page.
    document.addEventListener("astro:after-swap", dedupeUpdateIds);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", dedupeUpdateIds, {
        once: true,
      });
    } else {
      dedupeUpdateIds();
    }
  }
</script>
