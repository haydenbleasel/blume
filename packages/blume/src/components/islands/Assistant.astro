---
import type { CaptchaSettings } from "../../captcha/schema.ts";
import type { UIStrings } from "../../core/i18n-ui.ts";
import { resolveIcon } from "../../theme/icons.ts";
import Assistant from "./assistant.tsx";

interface Suggestion {
  icon?: string;
  label: string;
}

interface Props {
  /** The bot check's public settings (`ai.assistant.captcha`). */
  captcha?: CaptchaSettings;
  endpoint?: string;
  strings?: UIStrings["assistant"];
  suggestions?: Suggestion[];
  /** The Contact support link (`ai.assistant.support`). */
  support?: string;
}

const { captcha, endpoint, strings, suggestions = [], support } =
  Astro.props;

// Icons resolve to inline SVG here (server-only module), so the client island
// gets ready-to-render markup rather than a name it can't resolve. Bare Lucide
// bodies carry no styling, so wrap them in a stroke-styled root like Icon.astro.
const svgFor = (name: string | undefined): string | null => {
  const resolved = resolveIcon(name ?? "sparkles") ?? resolveIcon("sparkles");
  return resolved
    ? `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${resolved.viewBox}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${resolved.body}</svg>`
    : null;
};

const items = suggestions.map((suggestion) => ({
  icon: svgFor(suggestion.icon),
  label: suggestion.label,
}));

// The panel's own chrome glyphs resolve here too, so the client island carries
// no icon data. Each value is the bare Lucide body; the island's <Glyph> wraps
// it in a sized, stroke-styled <svg>. Keyed by role → Lucide icon name.
const bodyFor = (name: string): string => resolveIcon(name)?.body ?? "";
const icons = {
  arrowUp: bodyFor("arrow-up"),
  chat: bodyFor("message-circle"),
  clear: bodyFor("trash-2"),
  close: bodyFor("chevrons-right"),
  copy: bodyFor("copy"),
  remove: bodyFor("x"),
};
---

{/* transition:persist carries the island — and with it the conversation,
    the draft input, and the open panel — across client-router navigations
    instead of remounting it empty on every page. The island re-portals its
    panel and re-stamps the body push attribute itself on astro:after-swap
    (see assistant.tsx), since the swap replaces <body> wholesale. */}
<Assistant
  captcha={captcha}
  client:load
  endpoint={endpoint}
  icons={icons}
  strings={strings}
  suggestions={items}
  support={support}
  transition:persist="blume-assistant"
/>

<style is:global>
  :root {
    --blume-assistant-width: min(30rem, 100vw);
  }

  /* Desktop docks the panel and shrinks the page to fit, like vercel.com/docs.
     On smaller screens the panel is a full-width overlay (no push). */
  @media (min-width: 1024px) {
    body {
      transition: padding-inline-end 0.2s ease-out;
    }

    body[data-blume-assistant="open"] {
      padding-inline-end: var(--blume-assistant-width);
    }
  }

  /* The table of contents only shows at xl; reclaim its column for the article
     while the panel is open so the shrunken content still has room to breathe.
     Scoped to grids that actually have a TOC column: a "bare" layout (the
     changelog index) is single-column, and forcing the sidebar tracks onto it
     would squeeze its only item — <main> — into the sidebar track. */
  @media (min-width: 1280px) {
    body[data-blume-assistant="open"] [data-blume-toc] {
      display: none;
    }

    body[data-blume-assistant="open"] [data-blume-doc-grid]:has([data-blume-toc]) {
      grid-template-columns: var(--blume-sidebar-width, 17.5rem) minmax(0, 1fr);
    }
  }
</style>
