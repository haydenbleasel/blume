---
// The sidebar's client behavior, split out of NavTree so a subtree rendered
// into the sidebar cache (see nav-cache.ts) never carries a copy of it: Astro
// emits a component's script where the component renders, and a cached
// subtree would replay the copy captured on its first render on every later
// page, next to the live root's own. Rendered by the root NavTree only, when
// a `page`-mode group gives the panel stack something to do or sections are
// deferred.
//
// Two jobs. The `<blume-nav>` drill-in panel stack; and deferred sections —
// a collapsed group's children or an inactive panel's contents left out of
// the page as an empty element with `data-nav-src`, fetched from the
// prerendered fragment at that URL on first open (and prefetched on hover or
// focus, so the open is usually instant). Fetched fragments are kept for the
// session, so a section opened once is free on every later page.
---

<script>
  const DURATION = 260;
  const EASING = "cubic-bezier(0.33, 1, 0.68, 1)";

  /** Fragment URL → its HTML, once fetched (shared across router swaps). */
  const fragments = new Map<string, Promise<string>>();

  const loadFragment = (src: string): Promise<string> => {
    let pending = fragments.get(src);
    if (!pending) {
      pending = fetch(src, { headers: { Accept: "text/html" } }).then(
        (response) => {
          if (!response.ok) {
            throw new Error(`Sidebar fragment ${src} responded ${response.status}`);
          }
          return response.text();
        }
      );
      fragments.set(src, pending);
      // A failed fetch is retried on the next open rather than cached.
      pending.catch(() => fragments.delete(src));
    }
    return pending;
  };

  /**
   * Fill a deferred element from its fragment; a no-op once filled. The rows
   * are appended, not swapped in: a drill-in panel keeps its own back row
   * (the Back button and the section's title) above the deferred rows, and a
   * collapsed group's slot is empty anyway.
   */
  const fillDeferred = async (slot: HTMLElement): Promise<void> => {
    const src = slot.dataset.navSrc;
    if (!src) {
      return;
    }
    slot.setAttribute("aria-busy", "true");
    try {
      const html = await loadFragment(src);
      // Two opens racing on the same fetch fill it once.
      if (slot.dataset.navSrc) {
        slot.insertAdjacentHTML("beforeend", html);
        delete slot.dataset.navSrc;
      }
    } finally {
      slot.removeAttribute("aria-busy");
    }
  };

  const deferredIn = (element: Element | null): HTMLElement | null =>
    element instanceof HTMLElement && element.dataset.navSrc ? element : null;

  // Delegated at the document so the handlers survive client-router swaps
  // (the document persists; only its tree is replaced). Module scripts run
  // once per real load, and the flag keeps a second copy of this module —
  // a page that renders two trees — from doubling the listeners.
  let installed = false;
  const install = (): void => {
    if (installed) {
      return;
    }
    installed = true;
    document.addEventListener(
      "toggle",
      (event) => {
        const details = event.target;
        if (!(details instanceof HTMLDetailsElement) || !details.open) {
          return;
        }
        const slot = deferredIn(details.querySelector(":scope > [data-nav-src]"));
        if (slot) {
          // A fragment that can't load (offline, a deploy that dropped it)
          // closes the group again instead of leaving it open and empty; the
          // slot keeps its `data-nav-src`, so the next open retries.
          fillDeferred(slot).catch(() => {
            details.open = false;
          });
        }
      },
      true
    );
    // Prefetch on intent: a hovered or focused summary, or a drill-in row.
    const prefetch = (event: Event): void => {
      const target = event.target;
      if (!(target instanceof Element)) {
        return;
      }
      const summary = target.closest("summary");
      const slot = summary
        ? deferredIn(summary.parentElement?.querySelector(":scope > [data-nav-src]") ?? null)
        : null;
      if (slot?.dataset.navSrc) {
        void loadFragment(slot.dataset.navSrc).catch(() => undefined);
        return;
      }
      const drill = target.closest("[data-nav-to]");
      const nav = drill?.closest("blume-nav");
      if (drill && nav instanceof BlumeNav) {
        const panel = deferredIn(nav.panel(drill.getAttribute("data-nav-to") ?? ""));
        if (panel?.dataset.navSrc) {
          void loadFragment(panel.dataset.navSrc).catch(() => undefined);
        }
      }
    };
    document.addEventListener("pointerover", prefetch);
    document.addEventListener("focusin", prefetch);
  };

  class BlumeNav extends HTMLElement {
    active: HTMLElement | null = null;
    finishSlide: (() => void) | null = null;

    connectedCallback() {
      if (this.dataset.ready) {
        return;
      }
      this.dataset.ready = "1";
      this.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }
        const drill = target.closest("[data-nav-to]");
        if (drill && this.contains(drill)) {
          const id = drill.getAttribute("data-nav-to");
          if (id && this.panel(id)) {
            event.preventDefault();
            void this.show(id, true);
          }
          return;
        }
        const back = target.closest("[data-nav-back]");
        if (back && this.contains(back)) {
          event.preventDefault();
          void this.show(back.getAttribute("data-nav-back") || "root", true);
        }
      });
      // Initial panel is route-driven, so it snaps into place without a slide.
      void this.show(this.dataset.initial || "root", false);
    }

    panel(id: string): HTMLElement | null {
      return this.querySelector(`[data-nav-panel="${id}"]`);
    }

    depth(panel: HTMLElement): number {
      return Number(panel.dataset.navDepth ?? "0");
    }

    reduced(): boolean {
      return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    }

    async show(id: string, animate: boolean): Promise<void> {
      const next = this.panel(id) || this.panel("root");
      if (!next) {
        return;
      }
      // A deferred panel loads its contents before it slides in. When its
      // fragment can't load (offline, a deploy that dropped it), the drill-in
      // follows the section's own page link — the panel's title — instead of
      // leaving the click dead. A section with no page stays put, and the next
      // drill-in retries the fetch.
      try {
        await fillDeferred(next);
      } catch {
        next.querySelector<HTMLAnchorElement>("a[href]")?.click();
        return;
      }
      const prev = this.active;
      if (prev === next) {
        return;
      }
      // The pressed drill or back button sits in the panel about to hide, so
      // its focus has to move into the panel replacing it — left behind, the
      // next Tab would leave the sidebar.
      const hadFocus = prev?.contains(document.activeElement) ?? false;
      // Settle any in-flight slide before starting the next one.
      if (this.finishSlide) {
        this.finishSlide();
      }
      this.active = next;
      this.dataset.active = next.dataset.navPanel;
      this.syncExpanded(next);

      if (!(animate && prev) || this.reduced()) {
        for (const panel of this.querySelectorAll<HTMLElement>("[data-nav-panel]")) {
          panel.hidden = panel !== next;
        }
      } else {
        this.slide(prev, next, this.depth(next) > this.depth(prev));
      }
      if (hadFocus && prev) {
        this.focusInto(next, prev);
      }
    }

    /** Each drill button is expanded exactly while the panel it opens shows. */
    syncExpanded(shown: HTMLElement): void {
      for (const drill of this.querySelectorAll("[data-nav-to]")) {
        drill.setAttribute(
          "aria-expanded",
          String(drill.getAttribute("data-nav-to") === shown.dataset.navPanel)
        );
      }
    }

    /**
     * Focus `next` after leaving `prev`: going back, the drill button that
     * opened `prev`; drilling in, the new panel's back button (its first
     * control). `preventScroll` keeps the focus from scrolling the clipped
     * container mid-slide.
     */
    focusInto(next: HTMLElement, prev: HTMLElement): void {
      const target =
        next.querySelector<HTMLElement>(
          `[data-nav-to="${prev.dataset.navPanel}"]`
        ) ?? next.querySelector<HTMLElement>("button, a[href]");
      target?.focus({ preventScroll: true });
    }

    slide(out: HTMLElement, into: HTMLElement, forward: boolean): void {
      const rtl = getComputedStyle(this).direction === "rtl" ? -1 : 1;
      const sign = (forward ? -1 : 1) * rtl;

      const fromHeight = out.offsetHeight;
      this.style.position = "relative";
      this.style.overflow = "hidden";
      this.style.height = `${fromHeight}px`;
      into.hidden = false;
      for (const panel of [out, into]) {
        panel.style.position = "absolute";
        panel.style.top = "0";
        panel.style.insetInlineStart = "0";
        panel.style.width = "100%";
      }
      const toHeight = into.offsetHeight;
      this.style.height = `${toHeight}px`;

      const options = { duration: DURATION, easing: EASING };
      const animations = [
        out.animate(
          [
            { transform: "translateX(0)" },
            { transform: `translateX(${sign * 100}%)` },
          ],
          options
        ),
        into.animate(
          [
            { transform: `translateX(${-sign * 100}%)` },
            { transform: "translateX(0)" },
          ],
          options
        ),
        this.animate(
          [{ height: `${fromHeight}px` }, { height: `${toHeight}px` }],
          options
        ),
      ];

      let done = false;
      const finish = () => {
        if (done) {
          return;
        }
        done = true;
        for (const animation of animations) {
          animation.cancel();
        }
        out.hidden = true;
        for (const panel of [out, into]) {
          panel.style.position = "";
          panel.style.top = "";
          panel.style.insetInlineStart = "";
          panel.style.width = "";
          panel.style.transform = "";
        }
        this.style.position = "";
        this.style.overflow = "";
        this.style.height = "";
        this.finishSlide = null;
      };
      this.finishSlide = finish;
      animations[0]?.finished.then(finish, finish);
    }
  }

  install();
  if (!customElements.get("blume-nav")) {
    customElements.define("blume-nav", BlumeNav);
  }
</script>
