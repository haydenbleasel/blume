---
// The site footer, below the content on every page: one row, as tall as the
// header, with `footer.links` on one side and the social profile icons on the
// other. The site's repository (`github`, unless `navigation.repo` hides it)
// is the first icon; the footer is the only place it's linked. With `consent` configured the links end with the
// Cookie settings link, which reopens the reader's consent choices. Renders
// nothing when there's none of these; a `components.ts` `Footer` replaces it.
import data from "blume:data";

import type { BlumeDataConfig } from "../../core/data.ts";
import type { Navigation } from "../../core/types.ts";
import { EN_UI } from "../../core/i18n-ui.ts";
import type { UIStrings } from "../../core/i18n-ui.ts";
import { routeSetFor } from "../../core/locale-links.ts";
import { newTabAttrs } from "../../core/new-tab.ts";
import Icon from "../Icon.astro";
import { withBase } from "../islands/base-path.ts";
import { footerLinks } from "./footer-links.ts";
import { footerSocialLinks } from "./footer-socials.ts";

interface Props {
  footer?: BlumeDataConfig["footer"];
  /**
   * Active locale of the page: labels written as per-locale maps show its
   * entry, and internal links move into it (see `footer-links.ts`).
   */
  locale?: string;
  /** The page's navigation: its `repoUrl` is the repository link. */
  navigation?: Navigation;
  /** Localized UI strings; the Cookie settings label comes from `consent`. */
  ui?: UIStrings;
}

const { footer, locale, navigation, ui } = Astro.props;
// `github`, as `navigation.repo` leaves it: hidden, or pointed elsewhere.
const repoUrl = navigation?.repoUrl;
const socials = footerSocialLinks(
  footer?.socials ?? {},
  repoUrl
    ? { href: repoUrl, label: { ...EN_UI.nav, ...ui?.nav }.githubRepository }
    : null
);
const links = footerLinks(footer?.links ?? [], {
  basePath: data.config.basePath,
  i18n: data.config.i18n,
  locale,
  routes: routeSetFor(data.routes),
});
const consentSettings = data.config.consent
  ? { ...EN_UI.consent, ...ui?.consent }.settings
  : null;
const linkClass =
  "text-muted-foreground transition-colors hover:text-foreground focus-visible:text-foreground";
// Round icon buttons, like the header's.
const iconButton =
  "inline-flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:text-foreground";
const hasLinks = links.length > 0 || consentSettings !== null;
---

{
  (hasLinks || socials.length > 0) && (
    <footer class="border-border border-t px-4 md:px-6" data-blume-footer>
      <div class="flex min-h-16 flex-wrap items-center justify-between gap-x-6 gap-y-3 py-3">
        {hasLinks && (
          <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
            {links.map((link) => (
              <li>
                <a
                  class={linkClass}
                  href={withBase(link.href)}
                  {...newTabAttrs(link.href)}
                >
                  {link.label}
                </a>
              </li>
            ))}
            {consentSettings && (
              <li>
                <button
                  class:list={[linkClass, "cursor-pointer"]}
                  data-blume-consent-open
                  type="button"
                >
                  {consentSettings}
                </button>
              </li>
            )}
          </ul>
        )}
        {/* Pulled out by the buttons' padding, so the glyphs line up with the
            footer's edge, and pushed to the far side even with no links. */}
        {socials.length > 0 && (
          <ul class="-me-[9px] -my-[9px] ms-auto flex flex-wrap items-center gap-1">
            {socials.map((social) => (
              <li>
                <a
                  aria-label={social.label}
                  class={iconButton}
                  href={withBase(social.href)}
                  title={social.label}
                  {...newTabAttrs(social.href)}
                >
                  {social.path ? (
                    <svg
                      aria-hidden="true"
                      fill="currentColor"
                      height="18"
                      viewBox="0 0 24 24"
                      width="18"
                    >
                      <path d={social.path} />
                    </svg>
                  ) : (
                    <Icon name={social.icon} size={18} />
                  )}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </footer>
  )
}
