---
import VercelAnalytics from "@vercel/analytics/astro";

import { analyticsHead } from "../../analytics/head.ts";
import type { BlumeDataConfig } from "../../core/data.ts";

// The analytics adapters' <head> output. Each adapter in `analytics` owns the
// snippet it emits (src/analytics/*); `analyticsHead` collects them and this
// component renders the result: the official Vercel component when `vercel()`
// is listed, and one <script> per other adapter, in configured order. Loads
// ONLY in production builds so `blume dev` stays clean and local traffic never
// reaches your analytics.
interface Props {
  analytics?: BlumeDataConfig["analytics"] | null;
}

const { analytics } = Astro.props;
const head = analyticsHead(import.meta.env.PROD ? (analytics ?? []) : []);
---

{head.vercel && <VercelAnalytics {...head.vercel} />}
{
  head.scripts.map((script) =>
    script.content === null ? (
      <script is:inline {...script.attributes} />
    ) : (
      <script is:inline set:html={script.content} {...script.attributes} />
    )
  )
}
