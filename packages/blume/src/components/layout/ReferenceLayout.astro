---
import IconSprite from "./IconSprite.astro";
import { createIconSprite } from "../icon-sprite.ts";
import "blume:theme";
import data from "blume:data";
import type {
  BlumeBanner,
  BlumeDataConfig,
  BlumeFavicon,
  DiscoveryHeadLinks,
} from "../../core/data.ts";
import { EN_UI } from "../../core/i18n-ui.ts";
import type { UIStrings } from "../../core/i18n-ui.ts";
import { NEW_TAB_HINT_ID } from "../../core/new-tab.ts";
import type { FontHead } from "../../theme/fonts.ts";
import type { Navigation } from "../../core/types.ts";
import Analytics from "./Analytics.astro";
import ConsentBanner from "./ConsentBanner.astro";
import ConsentHead from "./ConsentHead.astro";
import WebMcp from "./WebMcp.astro";
import Banner from "./Banner.astro";
import DiscoveryLinks from "./DiscoveryLinks.astro";
import Favicon from "./Favicon.astro";
import Fonts from "./Fonts.astro";
import {
  BANNER_INIT_SCRIPT,
  SCALAR_THEME_INIT_SCRIPT,
  THEME_INIT_SCRIPT,
} from "./head-scripts.ts";
import Header from "./Header.astro";
import { pageDirection, pageLocale } from "./page-locale.ts";
import { searchLocaleFor } from "./search-locale.ts";
import SiteMetatags from "./SiteMetatags.astro";

// A minimal shell for the Scalar API/AsyncAPI reference: Blume's banner + navbar
// on top, then a full-height region the reference mounts into. Unlike RootLayout
// it has no docs sidebar/TOC/prose column, so the reference renders edge to edge.
//
// Deliberately NOT wired into the client router (`<ClientRouter />`): Scalar is
// a SPA whose mount script runs once per real page load, so a client-side swap
// back onto this page would leave the mount region empty (Astro never re-runs a
// script it has already executed). Without the router's marker meta, the docs
// pages' router falls back to a normal full load when navigating here — exactly
// what a fresh Scalar mount needs.
interface Props {
  site: { title: string; description?: string };
  logo?: {
    svg?: string;
    light?: string;
    dark?: string;
    alt: string;
    href: string;
    text?: string;
  } | null;
  favicon?: BlumeFavicon | null;
  appleIcon?: BlumeFavicon | null;
  banner?: BlumeBanner | null;
  analytics?: BlumeDataConfig["analytics"] | null;
  navigation: Navigation;
  route: string;
  themeMode: "system" | "light" | "dark";
  fontCssVars?: (string | FontHead)[];
  searchEnabled: boolean;
  pageTitle: string;
  /** Keep the reference route out of crawler indexes. */
  noindex?: boolean;
  /**
   * Which agent-discovery resources exist, advertised in the head by the same
   * `DiscoveryLinks` partial the docs shells render; defaults to the
   * `blume:data` snapshot, `null` drops the links. A reference route has no
   * raw-Markdown mirror, so no `alternate` is emitted here.
   */
  discovery?: DiscoveryHeadLinks | null;
  /**
   * Active locale code for `<html lang>`. Defaults to the locale Astro
   * resolved from the URL (`Astro.currentLocale`), then the site default.
   */
  locale?: string;
  /** Text direction for `<html dir>`; defaults to the locale's configured direction. */
  dir?: "ltr" | "rtl";
  /** Resolved UI dictionary; English baseline when omitted. */
  ui?: UIStrings;
}

const {
  site,
  logo,
  favicon,
  appleIcon,
  banner,
  analytics,
  navigation,
  route,
  themeMode,
  fontCssVars,
  searchEnabled,
  pageTitle,
  noindex = false,
  discovery = data.config.discovery,
  locale: localeProp,
  dir: dirProp,
  ui,
} = Astro.props;

// The locale and direction: the page's own values when it passes them (the
// content catch-all always does), else what Astro's i18n routing resolved for
// this URL, else the site default (see `page-locale.ts`).
const locale = pageLocale(data.config.i18n, localeProp, Astro.currentLocale);
const dir = dirProp ?? pageDirection(data.config.i18n, locale);

const strings = ui ?? EN_UI;
// The consent adapter (`consent`), site-wide: analytics waits for the reader.
const consent = data.config.consent;
const navStrings = { ...EN_UI.nav, ...strings.nav };
// Scope search to the reference page's language on a multi-locale site.
const searchLocale = searchLocaleFor(data.config.i18n, locale);

const bannerKey = banner?.dismissible ? banner.key : null;

// Start the page's icon sprite before anything renders an icon (see
// icon-sprite.ts); <IconSprite /> at the end of the body emits it.
createIconSprite(Astro.locals);
---

<!doctype html>
<html dir={dir} lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <SiteMetatags tags={data.config.metatags} />
    <Favicon favicon={favicon} appleIcon={appleIcon} />
    <Fonts cssVars={fontCssVars ?? []} />
    <DiscoveryLinks discovery={discovery} />
    {
      bannerKey && (
        <script data-key={bannerKey} is:inline set:html={BANNER_INIT_SCRIPT} />
      )
    }
    <script data-mode={themeMode} is:inline set:html={THEME_INIT_SCRIPT} />
    {consent && <ConsentHead consent={consent} />}
    <Analytics analytics={analytics} />
  </head>
  <body class="bg-background font-sans text-foreground antialiased">
    <a
      class="absolute start-[-999px] top-0 z-[100] bg-accent px-4 py-2 text-accent-foreground focus:start-0"
      href="#blume-content">{strings.page.skipToContent}</a
    >
    {/* Every new-tab link's aria-describedby target (see core/new-tab.ts). */}
    <span hidden id={NEW_TAB_HINT_ID}>{navStrings.opensInNewTab}</span>
    <Banner banner={banner} locale={locale} strings={strings.banner} />
    <Header
      assistantStrings={strings.assistant}
      hasDrawer={false}
      hasSidebar={false}
      locale={locale}
      logo={logo}
      navStrings={navStrings}
      navigation={navigation}
      route={route}
      searchEnabled={searchEnabled}
      searchLocale={searchLocale}
      searchStrings={strings.search}
      site={site}
      switcherStrings={strings.languageSwitcher}
    />
    <div
      class="h-[calc(100dvh-4rem)] overflow-auto border-border border-t [&>[data-scalar-client]]:h-full"
      id="blume-content"
    >
      <slot />
      <script is:inline set:html={SCALAR_THEME_INIT_SCRIPT} />
    </div>
    <WebMcp />
    {
      consent?.kind === "native" && (
        <ConsentBanner
          policy={consent.options.policy}
          strings={strings.consent}
        />
      )
    }
  <IconSprite />
  </body>
</html>
