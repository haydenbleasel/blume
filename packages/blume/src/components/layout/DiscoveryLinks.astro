---
import type { DiscoveryHeadLinks } from "../../core/data.ts";
import { withMountedBase } from "../islands/base-path.ts";
// Emits the agent-discovery <link>s for the document <head>, on every page and
// not just the root: an agent that enters on a deep page (a search result, a
// shared link) never sees the homepage HTTP `Link` header (see
// `ai/link-headers.ts`), so the head carries the same `describedby` resources,
// the AI Catalog / ARD manifest pair, and — when the page has one — its own
// raw-Markdown mirror as an `alternate`. This also reaches hosts where Blume
// can't set response headers. Every shell (RootLayout, PageLayout,
// ReferenceLayout) renders this one partial, so the "every page's head"
// promise has a single definition. Both `describedby` and `alternate` are
// IANA-registered relations.
interface Props {
  /**
   * Which resources exist, from the `blume:data` snapshot; `null` drops every
   * link this partial renders, the Markdown alternate included (a page opting
   * out of the agent-facing surface).
   */
  discovery?: DiscoveryHeadLinks | null;
  /**
   * This page's raw-Markdown mirror (already under the deployment base), or
   * `null` when the route has none — only content routes and the homepage do
   * (see `markdownRoutePaths`). Advertised only while `discovery` is set.
   */
  markdownMirror?: string | null;
}

const { discovery, markdownMirror } = Astro.props;
---

{
  discovery?.agentReadability && (
    <link
      href={withMountedBase("/agent-readability.json")}
      rel="describedby"
      type="application/json"
    />
  )
}
{
  discovery?.llmsTxt && (
    <link
      href={withMountedBase("/llms.txt")}
      rel="describedby"
      type="text/plain"
    />
  )
}
{/* The AI Catalog / ARD manifest under both relations its two specs define:
    `ai-catalog` (ai-catalog spec) and `ard` (ARD v0.91), each pointing at that
    spec's own well-known path. */}
{
  discovery?.aiCatalog && (
    <>
      <link
        href={withMountedBase("/.well-known/ai-catalog.json")}
        rel="ai-catalog"
        type="application/ai-catalog+json"
      />
      <link
        href={withMountedBase("/.well-known/ard.json")}
        rel="ard"
        type="application/json"
      />
    </>
  )
}
{
  discovery && markdownMirror && (
    <link href={markdownMirror} rel="alternate" type="text/markdown" />
  )
}
