---
import { withMountedBase } from "../islands/base-path.ts";
import type { LocaleSwitchOption } from "../../core/types.ts";
import Icon from "../Icon.astro";

interface Props {
  options: LocaleSwitchOption[];
  label: string;
  untranslatedLabel: string;
  /**
   * `bar` (the default) for the header; `drawer` for the top of the nav
   * drawer, where the trigger spans the drawer and opens a panel as wide as
   * itself, so nothing reaches past the drawer edge.
   */
  variant?: "bar" | "drawer";
}

const { options, label, untranslatedLabel, variant = "bar" } = Astro.props;
const current = options.find((option) => option.current);
// The accessible name carries the visible language name too (WCAG 2.5.3,
// label in name), so a voice-control user can say "English" to open it.
const summaryLabel = current ? `${label}: ${current.label}` : label;

// In the header the trigger is styled like the icon buttons beside it: no
// border, a background on hover and while open. The drawer's spans the
// drawer, where the border marks it as a control.
const triggerClass =
  variant === "bar"
    ? "inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-full px-3 text-muted-foreground text-sm transition-colors hover:bg-muted hover:text-foreground group-open:bg-muted group-open:text-foreground"
    : "inline-flex h-9 w-full cursor-pointer items-center gap-1.5 rounded-full border border-border bg-background px-3 text-muted-foreground text-sm transition-colors hover:border-foreground hover:text-foreground";
const menuRowClass =
  "flex w-full items-center gap-4 rounded-md px-2 py-1.5 text-start text-muted-foreground text-sm transition-colors hover:bg-muted hover:text-foreground aria-[current=true]:text-foreground";
---

{
  options.length > 1 && (
    <details
      class:list={["group relative", variant === "drawer" && "w-full"]}
      data-blume-dropdown
    >
      <summary
        aria-label={summaryLabel}
        class:list={[triggerClass, "list-none [&::-webkit-details-marker]:hidden"]}
      >
        <span class:list={[variant === "drawer" && "flex-1 text-start"]}>
          {current?.label ?? label}
        </span>
        <Icon
          class="transition-transform group-open:rotate-180"
          name="chevron-down"
          size={14}
        />
      </summary>
      <div
        class:list={[
          "absolute z-50 mt-2 rounded-blume border border-border bg-background p-1 shadow-xl",
          // As wide as its longest row: the panel hangs from a narrow trigger,
          // so it wouldn't otherwise grow past its minimum.
          variant === "bar"
            ? "end-0 w-max min-w-44 max-w-[calc(100vw-1rem)]"
            : "inset-x-0",
        ]}
      >
        {options.map((option) => (
          <a
            aria-current={option.current ? "true" : undefined}
            class={menuRowClass}
            data-blume-locale-choice
            href={withMountedBase(option.href)}
            hreflang={option.code}
            lang={option.code}
          >
            {/* The name keeps its full width, so the panel grows to fit the
                longest row; the note and check sit at the far end. */}
            <span>{option.label}</span>
            {(option.untranslated || option.current) && (
              <span class="ms-auto flex items-center gap-2.5">
                {option.untranslated && (
                  <span class="text-muted-foreground text-xs italic">
                    {untranslatedLabel}
                  </span>
                )}
                {option.current && <Icon name="check" size={14} />}
              </span>
            )}
          </a>
        ))}
      </div>
    </details>
  )
}

<script>
  import { installDropdownDismiss } from "../dropdown-dismiss.ts";
  import { rememberLocaleChoice } from "./locale-redirect.ts";

  // Outside-click / Escape / focus-out dismissal, shared with the nav
  // selectors and the page actions.
  installDropdownDismiss();
  // A language picked here stops routing by browser language.
  rememberLocaleChoice(document);
</script>
