---
import { withMountedBase } from "../islands/base-path.ts";
import type { LocaleSwitchOption } from "../../core/types.ts";
import Icon from "../Icon.astro";

interface Props {
  options: LocaleSwitchOption[];
  label: string;
  untranslatedLabel: string;
  /**
   * `bar` (the default) for the header, where the language name collapses to
   * the globe below `lg`; `drawer` for the top of the nav drawer, where the
   * trigger spans the drawer, shows the name, and opens a panel as wide as
   * itself, so nothing reaches past the drawer edge.
   */
  variant?: "bar" | "drawer";
}

const { options, label, untranslatedLabel, variant = "bar" } = Astro.props;
const current = options.find((option) => option.current);
// The accessible name carries the visible language name too (WCAG 2.5.3,
// label in name), so a voice-control user can say "English" to open it.
const summaryLabel = current ? `${label}: ${current.label}` : label;

const iconButton =
  "inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-full border border-border bg-background px-3 text-muted-foreground text-sm transition-colors hover:border-foreground hover:text-foreground";
const menuRowClass =
  "flex w-full items-center gap-2.5 rounded-md px-2 py-1.5 text-start text-muted-foreground text-sm transition-colors hover:bg-muted hover:text-foreground aria-[current=true]:text-foreground";
---

{
  options.length > 1 && (
    <details
      class:list={["group relative", variant === "drawer" && "w-full"]}
      data-blume-dropdown
    >
      <summary
        aria-label={summaryLabel}
        class:list={[
          iconButton,
          "list-none [&::-webkit-details-marker]:hidden",
          variant === "drawer" && "w-full",
        ]}
      >
        <Icon name="globe" size={16} />
        {/* Collapses to the globe icon below `lg`, matching the search field. */}
        <span class={variant === "bar" ? "max-lg:hidden" : "flex-1 text-start"}>
          {current?.label ?? label}
        </span>
        <Icon
          class="transition-transform group-open:rotate-180"
          name="chevron-down"
          size={14}
        />
      </summary>
      <div
        class:list={[
          "absolute z-50 mt-2 rounded-blume border border-border bg-background p-1 shadow-xl",
          variant === "bar" ? "end-0 min-w-44" : "inset-x-0",
        ]}
      >
        {options.map((option) => (
          <a
            aria-current={option.current ? "true" : undefined}
            class={menuRowClass}
            data-blume-locale-choice
            href={withMountedBase(option.href)}
            hreflang={option.code}
            lang={option.code}
          >
            <span class="flex-1">{option.label}</span>
            {option.untranslated && (
              <span class="text-muted-foreground text-xs italic">
                {untranslatedLabel}
              </span>
            )}
            {option.current && <Icon name="check" size={14} />}
          </a>
        ))}
      </div>
    </details>
  )
}

<script>
  import { installDropdownDismiss } from "../dropdown-dismiss.ts";
  import { rememberLocaleChoice } from "./locale-redirect.ts";

  // Outside-click / Escape / focus-out dismissal, shared with the nav
  // selectors and the page actions.
  installDropdownDismiss();
  // A language picked here stops routing by browser language.
  rememberLocaleChoice(document);
</script>
