---
// A header tab with dropdown `items` (`navigation.tabs[].items`). In the
// header's tab bar (`variant="bar"`) it is the nav selectors' floating
// `<details>` dropdown: the `<summary>` is the disclosure button (the browser
// exposes its expanded state), the panel a list of links, and the shared
// light-dismiss closes it on an outside press, Escape (focus returns to the
// tab), or focus leaving it. In a navigation drawer (`variant="drawer"`) the
// same items expand in place under the tab, like a sidebar group, open from
// the start on the tab's own section. Both are server-rendered and the scripts
// delegate from `document`, so client-router swaps need no re-init.
import type { NavTab } from "../../core/types.ts";
import Icon from "../Icon.astro";
import { withMountedBase } from "../islands/base-path.ts";

interface Props {
  tab: NavTab;
  /** The page's route, to mark the item it is on. */
  route: string;
  /** Whether the current route falls under this tab. */
  active: boolean;
  variant: "bar" | "drawer";
}

const { tab, route, active, variant } = Astro.props;
const items = tab.items ?? [];
// The tab itself is a button, not a page, so its "you are here" state is
// `aria-current="true"` (current item of a set); an item is the page.
const tabCurrent = active ? "true" : undefined;
const itemCurrent = (path: string): "page" | undefined =>
  path === route ? "page" : undefined;

const barRowClass =
  "flex w-full items-start gap-2.5 rounded-md px-2 py-1.5 text-start text-muted-foreground text-sm transition-colors hover:bg-muted hover:text-foreground aria-[current=page]:text-foreground";
const drawerRowClass =
  "flex items-center gap-2 rounded-[0.65rem] px-2.5 py-1.5 text-muted-foreground text-sm transition-colors hover:bg-muted hover:text-foreground aria-[current=page]:bg-muted aria-[current=page]:text-foreground";
---

{
  variant === "bar" ? (
    <details class="group relative" data-blume-dropdown>
      <summary
        aria-current={tabCurrent}
        class="inline-flex cursor-pointer list-none items-center gap-1 rounded-full px-3 py-1.5 font-medium text-muted-foreground text-sm transition-colors hover:bg-muted hover:text-foreground aria-[current=true]:text-foreground [&::-webkit-details-marker]:hidden"
      >
        {tab.icon && (
          <Icon class="me-0.5 shrink-0" name={tab.icon} size={14} />
        )}
        {tab.label}
        <Icon
          class="transition-transform group-open:rotate-180"
          name="chevron-down"
          size={14}
        />
      </summary>
      <div
        class="absolute start-0 z-50 mt-2 min-w-56 max-w-[calc(100vw-1rem)] rounded-blume border border-border bg-background p-1 shadow-xl"
        data-blume-dropdown-panel
      >
        {items.map((item) => (
          <a
            aria-current={itemCurrent(item.path)}
            class={barRowClass}
            href={withMountedBase(item.path)}
          >
            {item.icon && <Icon class="mt-0.5" name={item.icon} size={16} />}
            <span class="flex-1">
              <span class="flex items-center gap-2">
                {item.label}
                {item.tag && (
                  <span class="rounded-full bg-muted px-1.5 py-0.5 text-[0.65rem] text-muted-foreground">
                    {item.tag}
                  </span>
                )}
              </span>
              {item.description && (
                <span class="mt-0.5 block text-muted-foreground text-xs">
                  {item.description}
                </span>
              )}
            </span>
          </a>
        ))}
      </div>
    </details>
  ) : (
    <details class="group" open={active}>
      <summary
        aria-current={tabCurrent}
        class="flex cursor-pointer list-none items-center gap-2 rounded-[0.65rem] px-2.5 py-1.5 font-medium text-muted-foreground text-sm transition-colors hover:bg-muted hover:text-foreground aria-[current=true]:text-foreground [&::-webkit-details-marker]:hidden"
      >
        {tab.icon && <Icon class="shrink-0" name={tab.icon} size={14} />}
        <span class="flex-1 truncate">{tab.label}</span>
        <Icon
          class="shrink-0 transition-transform group-open:rotate-180"
          name="chevron-down"
          size={14}
        />
      </summary>
      <ul class="m-0 ms-2.5 list-none space-y-px border-border border-s p-0 ps-2">
        {items.map((item) => (
          <li>
            <a
              aria-current={itemCurrent(item.path)}
              class={drawerRowClass}
              href={withMountedBase(item.path)}
            >
              {item.icon && (
                <Icon class="shrink-0" name={item.icon} size={14} />
              )}
              <span class="flex-1 truncate">{item.label}</span>
              {item.tag && (
                <span class="shrink-0 rounded-full bg-muted px-1.5 py-0.5 text-[0.65rem] text-muted-foreground">
                  {item.tag}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<script>
  import { installDropdownDismiss } from "../dropdown-dismiss.ts";
  import { installDropdownClamp } from "./dropdown-clamp.ts";

  // Outside-click / Escape / focus-out dismissal and viewport clamping for
  // the header dropdown, shared with the nav selectors. The drawer variant
  // opts into neither: it is an in-place disclosure, not a floating panel.
  installDropdownDismiss();
  installDropdownClamp();
</script>
