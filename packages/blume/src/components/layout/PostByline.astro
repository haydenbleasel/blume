---
// Below a blog post's title and description: who wrote it, and its cover.
import type { BlumeBlogPost } from "../../core/data.ts";
import PostAuthors from "./PostAuthors.astro";

interface Props {
  post: BlumeBlogPost;
}

const { post } = Astro.props;
---

{
  (post.authors.length > 0 || post.cover) && (
    <div
      class="not-prose mt-6 mb-8"
      data-blume-narration="skip"
      data-blume-post-byline
    >
      <PostAuthors authors={post.authors} />
      {post.cover && (
        <img
          alt={post.cover.alt}
          class:list={[
            "mb-0! max-h-[32rem] w-full rounded-blume border border-border object-cover",
            post.authors.length > 0 && "mt-6",
          ]}
          decoding="async"
          src={post.cover.src}
        />
      )}
    </div>
  )
}
