---
import data from "blume:data";

import type { SchemaLike } from "./helpers.ts";
import {
  type SchemaDirection,
  type SchemaNode,
  schemaTree,
} from "./schema-tree.ts";
import SchemaProperty from "./SchemaProperty.astro";
import { aroundPlaceholder, referenceStrings } from "./strings.ts";

interface Props {
  /** The schema to render, planned here when no `node` is given. */
  schema?: SchemaLike;
  /** An already-planned subtree: how nested tables render. */
  node?: SchemaNode;
  schemas: Record<string, SchemaLike>;
  expandAll?: boolean;
  /** Which way the data travels, which decides the fields left out. */
  direction?: SchemaDirection;
}

const {
  schema = {},
  node: planned,
  schemas,
  expandAll = false,
  direction,
} = Astro.props;

// The whole tree is planned once, at the top-level table, so that which named
// schemas expand is decided for the tree as a whole (see `schema-tree.ts`).
const node = planned ?? schemaTree(schema, schemas, direction);
const strings = referenceStrings(data, Astro.currentLocale);
const [circularBefore, circularAfter] = aroundPlaceholder(strings.circular, "{name}");
const [arrayBefore, arrayAfter] = aroundPlaceholder(strings.arrayOf, "{type}");
const COMBINATORS = { "Any of": strings.anyOf, "One of": strings.oneOf };
---

{
  node.kind === "circular" ? (
    <div class="text-muted-foreground text-sm">
      {circularBefore}<code class="text-foreground">{node.name}</code>{circularAfter}
    </div>
  ) : node.kind === "array" ? (
    <div>
      <div class="mb-2 text-muted-foreground text-xs">
        {arrayBefore}<code class="text-foreground">{node.itemsLabel}</code>{arrayAfter}
      </div>
      {node.items && (
        <Astro.self node={node.items.node} schemas={schemas} expandAll={expandAll} />
      )}
    </div>
  ) : node.kind === "branches" ? (
    <div class="flex flex-col gap-3">
      {node.rows && (
        <div class="not-prose">
          {node.rows.map((row) => (
            <SchemaProperty row={row} schemas={schemas} expandAll={expandAll} />
          ))}
        </div>
      )}
      <div class="text-muted-foreground text-xs">{COMBINATORS[node.label]}</div>
      {node.branches.map((branch, index) => (
        <div class="rounded-blume border border-border p-3">
          <div class="mb-2 font-medium text-foreground text-xs">
            {branch.label ||
              strings.option.replaceAll("{n}", () => String(index + 1))}
          </div>
          <Astro.self node={branch.slot.node} schemas={schemas} expandAll={expandAll} />
        </div>
      ))}
    </div>
  ) : node.kind === "properties" ? (
    <div class="not-prose">
      {node.rows.map((row) => (
        <SchemaProperty row={row} schemas={schemas} expandAll={expandAll} />
      ))}
    </div>
  ) : (
    <div class="text-muted-foreground text-sm">
      <code class="text-foreground">
        {node.kind === "named" ? node.name : node.label}
      </code>
    </div>
  )
}
