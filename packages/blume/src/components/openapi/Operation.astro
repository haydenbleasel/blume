---
import specs from "blume:openapi";
import { HTTP_METHODS, operationOf, specOf } from "../../openapi/model.ts";
import {
  mergeParameters,
  type ParameterLike,
  resolveComponentRef,
  type SchemaLike,
  type SpecValue,
} from "./helpers.ts";
import {
  effectiveServers,
  operationModel,
  type ServerLike,
} from "./operation-model.ts";
import { buildRequest, defaultValues } from "./request.ts";
import {
  effectiveSecurity,
  resolveSecurity,
  type SecurityRequirementLike,
  type SecuritySchemeLike,
} from "./security.ts";
import { DEPRECATED_LABEL_CLASS } from "../colors.ts";
import { customCodeSamples } from "./code-samples.ts";
import type { CodeSamplesCarrier } from "./code-samples.ts";
import { sampleLanguages } from "./snippets.ts";
import AsyncApiOperation from "./AsyncApiOperation.astro";
import GraphqlOperation from "./GraphqlOperation.astro";
import Authorization from "./Authorization.astro";
import Description from "./Description.astro";
import MethodBadge from "./MethodBadge.astro";
import ParametersTable from "./ParametersTable.astro";
import Playground from "./Playground.astro";
import RequestBody from "./RequestBody.astro";
import RequestPanel from "./RequestPanel.astro";
import Responses from "./Responses.astro";
import OperationPanel from "./OperationPanel.astro";

interface Props {
  source: string;
  id: string;
}

interface MediaTypeLike {
  schema?: SchemaLike;
  example?: SpecValue;
  examples?: SpecValue;
}

interface RequestBodyLike {
  $ref?: string;
  description?: string;
  required?: boolean;
  content?: Record<string, MediaTypeLike>;
}

interface ResponseLike {
  $ref?: string;
  description?: string;
  content?: Record<string, MediaTypeLike>;
}

/**
 * One callback: a map of runtime URL expressions
 * (`{$request.body#/callbackUrl}`) to the path item the API will call there,
 * or a `$ref` to one under `components.callbacks`.
 */
type CallbackLike = { $ref?: string } & Record<
  string,
  Record<string, unknown> | string | undefined
>;

interface FullOperation extends CodeSamplesCarrier {
  callbacks?: Record<string, CallbackLike>;
  summary?: string;
  description?: string;
  deprecated?: boolean;
  parameters?: ParameterLike[];
  requestBody?: RequestBodyLike;
  responses?: Record<string, ResponseLike>;
  security?: SecurityRequirementLike[];
  servers?: ServerLike[];
}

const { source, id } = Astro.props;
const spec = specOf(specs, source);
const ref = spec ? operationOf(spec, id) : undefined;
// The AsyncAPI and GraphQL front-ends render their own bodies; the lookups
// below are OpenAPI-shaped (paths, request/response) and resolve to nothing
// for them.
const isAsyncApi = spec?.kind === "asyncapi";
const isGraphql = spec?.kind === "graphql";

type PathItemLike = Record<string, unknown> & {
  parameters?: ParameterLike[];
  servers?: ServerLike[];
};

const doc = (spec?.document ?? {}) as {
  paths?: Record<string, PathItemLike>;
  // OpenAPI 3.1 webhooks: requests the API sends, keyed by name.
  webhooks?: Record<string, PathItemLike>;
  components?: {
    callbacks?: Record<string, CallbackLike>;
    schemas?: Record<string, SchemaLike>;
    parameters?: Record<string, ParameterLike>;
    requestBodies?: Record<string, RequestBodyLike>;
    responses?: Record<string, ResponseLike>;
    securitySchemes?: Record<string, SecuritySchemeLike>;
  };
  security?: SecurityRequirementLike[];
  servers?: ServerLike[];
};
const isWebhook = ref?.webhook === true;
const pathItem = ref
  ? isWebhook
    ? doc.webhooks?.[ref.path]
    : doc.paths?.[ref.path]
  : undefined;
const operation = (
  pathItem && ref ? pathItem[ref.method] : undefined
) as FullOperation | undefined;

const schemas = doc.components?.schemas ?? {};
const components = doc.components ?? {};
const params = mergeParameters(
  pathItem?.parameters,
  operation?.parameters,
  components
);
const requestBody = operation?.requestBody
  ? resolveComponentRef(operation.requestBody, components, "requestBodies")
  : undefined;
// A request body table leaves out `readOnly` fields. A webhook's or
// callback's body is a request the API sends, so it reads like a response
// (and like its payload example): `readOnly` fields in, `writeOnly` out.
const bodyDirection = isWebhook ? "response" : "request";
const responses = Object.fromEntries(
  Object.entries(operation?.responses ?? {}).map(([status, response]) => [
    status,
    resolveComponentRef(response, components, "responses"),
  ])
);

const security = resolveSecurity(
  effectiveSecurity(operation?.security, doc.security, isWebhook),
  doc.components?.securitySchemes
);

// One derived model feeds the static default sample, the playground form,
// and (client-side) the live samples + fetch — they can never drift apart. A
// webhook has none: the API sends it, so there is nothing for a reader to
// call, and its rail shows the payload instead.
const model =
  ref && operation && !isWebhook
    ? operationModel({
        components,
        method: ref.method,
        parameters: params,
        path: ref.path,
        requestBody,
        schemas,
        security,
        // An operation's own `servers` override its path item's, which
        // override the document's.
        servers: effectiveServers(
          operation.servers,
          pathItem?.servers,
          doc.servers
        ),
      })
    : null;
const sample = model ? buildRequest(model, defaultValues(model)) : null;
const languages = sampleLanguages(spec?.codeSamples ?? []);
// The spec's own `x-codeSamples`, shown ahead of the generated ones.
const customSamples = operation ? customCodeSamples(operation) : [];

/** One request the API makes back to the reader, flattened for rendering. */
interface CallbackEntry {
  expression: string;
  key: string;
  method: string;
  name: string;
  operation: FullOperation;
  /** The callback path item's own parameters, which each method inherits. */
  pathParameters?: ParameterLike[];
}

// Callbacks: for each named callback (resolved through
// `components.callbacks`), each URL expression, each method it declares.
const callbacks: CallbackEntry[] = Object.entries(
  operation?.callbacks ?? {}
).flatMap(([name, raw]) => {
  const callback = resolveComponentRef(raw, components, "callbacks");
  return Object.entries(callback).flatMap(([expression, item]) => {
    if (expression === "$ref" || typeof item !== "object" || item === null) {
      return [];
    }
    return HTTP_METHODS.flatMap((method) => {
      const entry = item[method];
      return typeof entry === "object" && entry !== null
        ? [
            {
              expression,
              key: `${name}-${expression}-${method}`,
              method,
              name,
              // SAFETY: a path item's method entry is an operation object; the
              // object check above guards a spec that put a scalar there.
              operation: entry as FullOperation,
              // SAFETY: the object check above passed, and a path item's
              // `parameters` is a parameter list, which `mergeParameters`
              // reads the way it reads an operation's.
              pathParameters: (item as PathItemLike).parameters,
            },
          ]
        : [];
    });
  });
});

/** A callback's parameters, request body, and responses, `$ref`s resolved. */
const callbackParts = (entry: CallbackEntry) => ({
  parameters: mergeParameters(
    entry.pathParameters,
    entry.operation.parameters,
    components
  ),
  requestBody: entry.operation.requestBody
    ? resolveComponentRef(entry.operation.requestBody, components, "requestBodies")
    : undefined,
  responses: Object.fromEntries(
    Object.entries(entry.operation.responses ?? {}).map(([status, response]) => [
      status,
      resolveComponentRef(response, components, "responses"),
    ])
  ),
});
---
{
  isAsyncApi ? (
    <AsyncApiOperation id={id} source={source} />
  ) : isGraphql ? (
    <GraphqlOperation id={id} source={source} />
  ) : !(spec && ref && operation) ? (
    <div class="text-muted-foreground">This API operation could not be found.</div>
  ) : (
    <div class="not-prose">
      <div class="mb-6 flex flex-wrap items-center gap-3">
        <MethodBadge method={ref.method} />
        <code class="break-all font-mono text-foreground text-sm">
          {ref.path}
        </code>
        {isWebhook && (
          <span class="rounded-md border border-border px-1.5 py-0.5 font-medium text-[0.625rem] text-muted-foreground uppercase tracking-wide">
            Webhook
          </span>
        )}
        {operation.deprecated && (
          <span class={DEPRECATED_LABEL_CLASS}>
            deprecated
          </span>
        )}
      </div>
      <div class="grid grid-cols-1 items-start gap-x-10 gap-y-8 xl:grid-cols-[minmax(0,1fr)_minmax(0,28rem)]">
        <div>
          <Authorization security={security} />
          <ParametersTable parameters={params} schemas={schemas} />
          {requestBody && (
            <RequestBody
              direction={bodyDirection}
              expandAll={spec.expandSchemas}
              requestBody={requestBody}
              schemas={schemas}
            />
          )}
          {operation.responses && (
            <Responses
              expandAll={spec.expandSchemas}
              responses={responses}
              schemas={schemas}
            />
          )}
          {callbacks.length > 0 && (
            <section class="mt-10">
              <div
                aria-level="2"
                class="mb-3 font-semibold text-foreground text-lg"
                role="heading"
              >
                Callbacks
              </div>
              <div class="flex flex-col gap-6">
                {callbacks.map((entry) => {
                  const parts = callbackParts(entry);
                  return (
                    <div class="rounded-blume border border-border p-4">
                      <div
                        aria-level="3"
                        class="font-semibold text-foreground"
                        role="heading"
                      >
                        {entry.operation.summary || entry.name}
                      </div>
                      <div class="mt-2 flex flex-wrap items-center gap-2">
                        <MethodBadge method={entry.method} />
                        <code class="break-all font-mono text-muted-foreground text-xs">
                          {entry.expression}
                        </code>
                      </div>
                      {entry.operation.description && (
                        <Description
                          class="mt-2 text-muted-foreground text-sm"
                          text={entry.operation.description}
                        />
                      )}
                      <ParametersTable
                        level={4}
                        parameters={parts.parameters}
                        schemas={schemas}
                      />
                      {parts.requestBody && (
                        <RequestBody
                          direction="response"
                          expandAll={spec.expandSchemas}
                          level={4}
                          requestBody={parts.requestBody}
                          schemas={schemas}
                        />
                      )}
                      {entry.operation.responses && (
                        <Responses
                          expandAll={spec.expandSchemas}
                          level={4}
                          responses={parts.responses}
                          schemas={schemas}
                        />
                      )}
                    </div>
                  );
                })}
              </div>
            </section>
          )}
        </div>
        {isWebhook && (requestBody?.content || operation.responses) && (
          <OperationPanel>
            <RequestPanel
              components={components}
              customSamples={customSamples}
              payload={requestBody?.content}
              responses={responses}
              schemas={schemas}
            />
          </OperationPanel>
        )}
        {sample && model && (
          <OperationPanel>
            {spec.playground.enabled && (
              <Playground
                model={model}
                operation={id}
                proxy={spec.playground.proxy}
                proxyConfig="openapi"
                slug={spec.slug}
              />
            )}
            <RequestPanel
              components={components}
              customSamples={customSamples}
              languages={languages}
              responses={responses}
              sample={sample}
              schemas={schemas}
            />
          </OperationPanel>
        )}
      </div>
    </div>
  )
}
