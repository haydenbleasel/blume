---
import { statusColor } from "../colors.ts";
import Description from "./Description.astro";
import type { SchemaLike } from "./helpers.ts";
import SchemaTable from "./SchemaTable.astro";

interface MediaTypeLike {
  schema?: SchemaLike;
}

interface ResponseLike {
  description?: string;
  content?: Record<string, MediaTypeLike>;
}

interface Props {
  responses: Record<string, ResponseLike>;
  schemas: Record<string, SchemaLike>;
  expandAll?: boolean;
  /** The heading's level: 2 on an operation, deeper inside a callback. */
  level?: number;
}

const { responses, schemas, expandAll = false, level = 2 } = Astro.props;

const items = Object.entries(responses);
---

{
  items.length > 0 && (
    <section class:list={[level > 2 ? "mt-5" : "mt-8"]}>
      <div
        aria-level={level}
        class:list={["mb-3 font-semibold text-foreground", level > 2 ? "text-sm" : "text-lg"]}
        role="heading"
      >
        Responses
      </div>
      <div class="flex flex-col gap-4">
        {items.map(([status, response]) => {
          const schema = (
            Object.entries(response.content ?? {}).find(([type]) =>
              type.includes("json")
            )?.[1] ?? Object.values(response.content ?? {})[0]
          )?.schema;
          return (
            <div class="rounded-blume border border-border p-4">
              <div class="flex flex-wrap items-center gap-2">
                <span
                  class:list={[
                    "not-prose inline-flex items-center rounded-md px-2 py-0.5 font-mono font-semibold text-xs",
                    statusColor(status),
                  ]}
                >
                  {status}
                </span>
                {response.description && (
                  <Description
                    class="min-w-0 text-muted-foreground text-sm"
                    text={response.description}
                  />
                )}
              </div>
              {schema && (
                <div class="mt-3">
                  <SchemaTable
                    direction="response"
                    expandAll={expandAll}
                    schema={schema}
                    schemas={schemas}
                  />
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  )
}
