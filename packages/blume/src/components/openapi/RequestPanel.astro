---
import data from "blume:data";

import { highlightCode } from "../../markdown/index.ts";
import {
  type ComponentsLike,
  type MediaLike,
  type SchemaLike,
  toJson,
} from "./helpers.ts";
import type { CustomCodeSample } from "./code-samples.ts";
import {
  type ExamplePanel,
  payloadPanels as payloadExamples,
  type ResponseLike,
  responsePanels as responseExamples,
} from "./example-panels.ts";
import { languageSamplePanels } from "./sample-panels.ts";
import PanelTabs from "./PanelTabs.astro";
import type { RequestSample, SampleLanguage } from "./snippets.ts";
import { referenceStrings } from "./strings.ts";

interface Props {
  /** The document's `components`, which `$ref`'d examples resolve against. */
  components?: ComponentsLike;
  /** The spec's hand-written `x-codeSamples`, shown first and never re-rendered live. */
  customSamples?: CustomCodeSample[];
  /**
   * A webhook's body: the rail shows it as a "Payload" example per media
   * type in place of client code, since the API sends the request.
   */
  payload?: Record<string, MediaLike>;
  sample?: RequestSample;
  languages?: SampleLanguage[];
  responses: Record<string, ResponseLike>;
  schemas: Record<string, SchemaLike>;
}

const {
  components,
  customSamples = [],
  payload,
  sample,
  languages = [],
  responses,
  schemas,
} = Astro.props;
const strings = referenceStrings(data, Astro.currentLocale);

/**
 * One example tab, highlighted. A payload that isn't JSON shows a string
 * example as written; a response example always reads as JSON.
 */
const highlightPanel = async (panel: ExamplePanel, asText: boolean) => {
  const { value } = panel;
  const text = asText && typeof value === "string";
  return {
    html:
      value === undefined || value === null
        ? null
        : await highlightCode(
            text ? value : toJson(value),
            text ? "text" : "json",
            { icons: false, themes: data.config.codeThemes }
          ),
    key: panel.key,
    label: panel.label,
    text: panel.text,
  };
};

// Hand-written samples carry no `lang` key, so the playground leaves them
// as written when it re-renders the generated ones from the form.
const customPanels = await Promise.all(
  customSamples.map(async (custom) => ({
    html: await highlightCode(custom.source, custom.lang, {
      icons: false,
      themes: data.config.codeThemes,
    }),
    key: custom.key,
    label: custom.label,
  }))
);
const payloadPanels = await Promise.all(
  payloadExamples(payload, schemas, strings.noExamplePayload, components).map((panel) =>
    highlightPanel(panel, !panel.type.includes("json"))
  )
);
const requestPanels = [
  ...customPanels,
  ...(sample
    ? await languageSamplePanels(languages, sample, data.config.codeThemes)
    : []),
];
const responsePanels = await Promise.all(
  responseExamples(responses, schemas, strings.noExampleResponse, components).map((panel) =>
    highlightPanel(panel, false)
  )
);
---

<div class="not-prose flex flex-col gap-6">
  <PanelTabs copy heading={strings.payload} mono name="payload" panels={payloadPanels} />
  <PanelTabs copy heading={strings.request} name="request" panels={requestPanels} />
  <PanelTabs heading={strings.response} mono name="response" panels={responsePanels} />
</div>
