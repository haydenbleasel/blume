---
import data from "blume:data";

import Description from "./Description.astro";
import {
  constraints,
  isNullable,
  resolveSchema,
  type SchemaLike,
  typeLabel,
} from "./helpers.ts";
import { rowExpands, type SchemaRow } from "./schema-tree.ts";
import SchemaTable from "./SchemaTable.astro";
import { referenceStrings } from "./strings.ts";

interface Props {
  /** One planned row of the parent table (see `schema-tree.ts`). */
  row: SchemaRow;
  schemas: Record<string, SchemaLike>;
  expandAll?: boolean;
}

const { row, schemas, expandAll = false } = Astro.props;
const { name, schema, required } = row;
const strings = referenceStrings(data, Astro.currentLocale);

const resolved = resolveSchema(schemas, schema);

const type = typeLabel(schema);
const description = resolved.description ?? schema.description ?? "";
const deprecated = resolved.deprecated === true;
const nullable = isNullable(resolved);
const enumValues = Array.isArray(resolved.enum) ? resolved.enum : null;
const limits = constraints(resolved, strings);

// Circles and schemas expanded elsewhere in the tree have no disclosure; the
// type label names them.
const children = rowExpands(row) ? row.children : undefined;
---

{/* The row's vertical scale is 8 / 12 / 16px, and every other reference table copies it. A
    description is a block of Markdown, not a line: at 4px it sat closer to the label above it
    than its own paragraphs sat to each other, and the disclosure below it touched the next row's
    divider. Each step separates a bigger unit than the one before. */}
<div class="border-border border-t py-4 first:border-t-0 last:pb-0">
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
    <code class="font-mono text-foreground text-sm">{name}</code>
    <span class="text-muted-foreground text-xs"
      >{type}{nullable ? " | null" : ""}</span
    >
    {
      required && (
        <span class="font-medium text-[0.625rem] text-red-600 uppercase tracking-wide dark:text-red-400">
          {strings.required}
        </span>
      )
    }
    {
      deprecated && (
        <span class="font-medium text-[0.625rem] text-muted-foreground uppercase tracking-wide line-through">
          {strings.deprecated}
        </span>
      )
    }
  </div>
  {
    description && (
      <Description class="mt-2 text-muted-foreground text-sm" text={description} />
    )
  }
  {
    limits.length > 0 && (
      <div class="mt-2 text-muted-foreground text-xs">{limits.join(" · ")}</div>
    )
  }
  {
    enumValues && (
      <div class="mt-2 flex flex-wrap items-center gap-1.5 text-xs">
        <span class="text-muted-foreground">{strings.allowed}</span>
        {enumValues.map((value) => (
          <code class="rounded bg-muted px-1 py-0.5 text-foreground">
            {String(value)}
          </code>
        ))}
      </div>
    )
  }
  {
    children && (
      <details class="mt-3" open={expandAll}>
        <summary class="cursor-pointer select-none text-accent text-xs hover:underline">
          <span class="[details[open]>summary_&]:hidden">{strings.showProperties}</span>
          <span class="hidden [details[open]>summary_&]:inline">{strings.hideProperties}</span>
        </summary>
        <div class="mt-3 border-border border-s ps-4">
          <SchemaTable
            node={children.node}
            schemas={schemas}
            expandAll={expandAll}
          />
        </div>
      </details>
    )
  }
</div>
