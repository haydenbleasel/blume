---
import Description from "./Description.astro";
import type { SchemaLike } from "./helpers.ts";
import type { SchemaDirection } from "./schema-tree.ts";
import SchemaTable from "./SchemaTable.astro";

interface MediaTypeLike {
  schema?: SchemaLike;
}

interface RequestBodyLike {
  description?: string;
  required?: boolean;
  content?: Record<string, MediaTypeLike>;
}

interface Props {
  requestBody: RequestBodyLike;
  schemas: Record<string, SchemaLike>;
  expandAll?: boolean;
  /** The heading's level: 2 on an operation, deeper inside a callback. */
  level?: number;
  /**
   * `request` (the default) leaves out `readOnly` fields; a webhook or
   * callback, which the API sends, reads like a response instead.
   */
  direction?: SchemaDirection;
}

const {
  requestBody,
  schemas,
  expandAll = false,
  level = 2,
  direction = "request",
} = Astro.props;

const entries = Object.entries(requestBody.content ?? {});
const chosen = entries.find(([type]) => type.includes("json")) ?? entries[0];
const contentType = chosen?.[0] ?? "application/json";
const schema = chosen?.[1]?.schema ?? {};
---

<section class:list={[level > 2 ? "mt-5" : "mt-8"]}>
  <div class="mb-2 flex flex-wrap items-center gap-2">
    <div
      aria-level={level}
      class:list={["font-semibold text-foreground", level > 2 ? "text-sm" : "text-lg"]}
      role="heading"
    >
      Request body
    </div>
    {
      requestBody.required && (
        <span class="font-medium text-[0.625rem] text-red-600 uppercase tracking-wide dark:text-red-400">
          required
        </span>
      )
    }
    <code class="text-muted-foreground text-xs">{contentType}</code>
  </div>
  {
    requestBody.description && (
      <Description class="text-muted-foreground text-sm" text={requestBody.description} />
    )
  }
  <div class="mt-3">
    <SchemaTable
      direction={direction}
      expandAll={expandAll}
      schema={schema}
      schemas={schemas}
    />
  </div>
</section>
