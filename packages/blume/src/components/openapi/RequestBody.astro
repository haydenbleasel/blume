---
import data from "blume:data";

import { highlightCode } from "../../markdown/index.ts";
import Description from "./Description.astro";
import { preferredMedia } from "./example-panels.ts";
import {
  type ComponentsLike,
  type MediaLike,
  namedExamples,
  type SchemaLike,
  toJson,
} from "./helpers.ts";
import PanelTabs from "./PanelTabs.astro";
import type { SchemaDirection } from "./schema-tree.ts";
import SchemaTable from "./SchemaTable.astro";
import { referenceStrings } from "./strings.ts";

interface RequestBodyLike {
  description?: string;
  required?: boolean;
  content?: Record<string, MediaLike>;
}

interface Props {
  requestBody: RequestBodyLike;
  schemas: Record<string, SchemaLike>;
  /** The document's `components`, which `$ref`'d examples resolve against. */
  components?: ComponentsLike;
  expandAll?: boolean;
  /** The heading's level: 2 on an operation, deeper inside a callback. */
  level?: number;
  /**
   * `request` (the default) leaves out `readOnly` fields; a webhook or
   * callback, which the API sends, reads like a response instead.
   */
  direction?: SchemaDirection;
  /** Names the body's example tabs in their element ids (one per callback). */
  name?: string;
}

const {
  requestBody,
  schemas,
  components,
  expandAll = false,
  level = 2,
  direction = "request",
  name = "request-body",
} = Astro.props;
const strings = referenceStrings(data, Astro.currentLocale);

const chosen = preferredMedia(requestBody.content);
const contentType = chosen?.[0] ?? "application/json";
const schema = chosen?.[1]?.schema ?? {};

// A body whose `examples` map names two or more shows each, under its name:
// the code samples and Try it start from the first one only.
const examplePanels = await Promise.all(
  (chosen ? namedExamples(chosen[1], schemas, direction, components) : []).map(
    async (example) => ({
      html: await highlightCode(toJson(example.value), "json", {
        icons: false,
        themes: data.config.codeThemes,
      }),
      key: example.key,
      label: example.label,
    })
  )
);
---

<section class:list={[level > 2 ? "mt-5" : "mt-8"]}>
  <div class="mb-2 flex flex-wrap items-center gap-2">
    <div
      aria-level={level}
      class:list={["font-semibold text-foreground", level > 2 ? "text-sm" : "text-lg"]}
      role="heading"
    >
      {strings.requestBody}
    </div>
    {
      requestBody.required && (
        <span class="font-medium text-[0.625rem] text-red-600 uppercase tracking-wide dark:text-red-400">
          {strings.required}
        </span>
      )
    }
    <code class="text-muted-foreground text-xs">{contentType}</code>
  </div>
  {
    requestBody.description && (
      <Description class="text-muted-foreground text-sm" text={requestBody.description} />
    )
  }
  <div class="mt-3">
    <SchemaTable
      direction={direction}
      expandAll={expandAll}
      schema={schema}
      schemas={schemas}
    />
  </div>
  {
    examplePanels.length > 0 && (
      <div class="not-prose mt-4">
        <PanelTabs copy heading={strings.examples} name={`${name}-examples`} panels={examplePanels} />
      </div>
    )
  }
</section>
